{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "./dist",
    "incremental": true,
    // Вне dist: иначе повторная сборка стирает кэш вместе с каталогом
    // и каждый прогон заново типизирует весь src (~14s вместо ~2s).
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
