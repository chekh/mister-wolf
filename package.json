{
  "name": "mister-wolf",
  "version": "3.4.4",
  "description": "A local-first project organization for AI assistants: goal-directed processes, project memory and governed learning",
  "keywords": [
    "ai-agents",
    "mcp",
    "memory",
    "semantic-memory",
    "cli",
    "local-first"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chekh/mister-wolf.git"
  },
  "bin": {
    "wolf": "dist/bootstrap/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "templates",
    "update-map.json"
  ],
  "scripts": {
    "build": "node scripts/build-incremental.mjs",
    "build:clean": "rm -rf dist node_modules/.cache/tsconfig.tsbuildinfo && tsc --incremental false",
    "prepublishOnly": "npm run build:clean",
    "build:dev": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:remote": "bash scripts/test-remote.sh",
    "lint": "tsc --noEmit --incremental false",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\" \"README.md\" \"*.json\" \"*.ts\"",
    "format:check": "prettier --check --cache \"src/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\" \"README.md\" \"*.json\" \"*.ts\"",
    "e2e": "npm run build && vitest run --config tests/e2e/vitest.config.ts",
    "bench:search": "npm run build && node scripts/bench-search.mjs",
    "bench:tokens": "node --disable-warning=ExperimentalWarning scripts/bench-tokens.mjs",
    "check": "node scripts/check-delivery-language.mjs && node scripts/check-glossary-consistency.mjs && node scripts/check-english-surface.mjs && npm run format:check && npm run build && npm run test:run",
    "check:quick": "npm run build && vitest run --changed",
    "check:full": "npm run check && npm run docs:verify",
    "docs:dev": "vitepress dev docs/site",
    "docs:build": "node scripts/generate-cli-reference.mjs && node scripts/generate-cli-site-page.mjs && node scripts/sync-changelog.mjs && vitepress build docs/site",
    "docs:preview": "vitepress preview docs/site",
    "docs:check": "npm run build && npm run docs:verify",
    "docs:verify": "npm run docs:build && node scripts/check-docs-links.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^12.0.0",
    "js-yaml": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.8.3",
    "typescript": "^5.4.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4"
  }
}
