{"type":"tool_use","timestamp":1788633782713,"sessionID":"ses_f8d1f048bffeWi62luRotMafVq","part":{"type":"tool","tool":"read","callID":"call_263e0fe4e9d344a3a97ce72c","state":{"status":"completed","input":{"filePath":"/tmp/wolfeval-v1/aa/A1/src/adapters/platforms/opencode-adapter.ts"},"output":"<path>/tmp/wolfeval-v1/aa/A1/src/adapters/platforms/opencode-adapter.ts</path>\n<type>file</type>\n<content>\n1: import * as fs from 'fs/promises';\n2: import { existsSync } from 'fs';\n3: import { join } from 'path';\n4: import { PlatformAdapter, McpCommand, PlatformConfig } from '../../ports/platform-adapter.port.js';\n5: import { parseJsonc } from './jsonc.js';\n6: import { writeFileAtomic } from '../fs/markdown-memory-store.js';\n7: import { UserFacingError } from '../../domain/errors.js';\n8: \n9: // ponytail: комментарии в opencode.jsonc теряются при rewrite (plain JSON валиден как JSONC);\n10: // сохранение комментариев = AST-редактор, YAGNI до запроса.\n11: export class OpencodeAdapter implements PlatformAdapter {\n12:   readonly id = 'opencode';\n13: \n14:   detect(projectRoot: string): boolean {\n15:     return (\n16:       existsSync(join(projectRoot, 'opencode.json')) ||\n17:       existsSync(join(projectRoot, 'opencode.jsonc')) ||\n18:       existsSync(join(projectRoot, '.opencode'))\n19:     );\n20:   }\n21: \n22:   /** Существующий конфиг (jsonc — только если нет json); для новой установки — opencode.json. */\n23:   private configFile(projectRoot: string): string {\n24:     if (existsSync(join(projectRoot, 'opencode.jsonc')) && !existsSync(join(projectRoot, 'opencode.json'))) {\n25:       return join(projectRoot, 'opencode.jsonc');\n26:     }\n27:     return join(projectRoot, 'opencode.json');\n28:   }\n29: \n30:   async readConfig(projectRoot: string): Promise<PlatformConfig | null> {\n31:     const file = this.configFile(projectRoot);\n32:     let raw: string | null = null;\n33:     try {\n34:       raw = await fs.readFile(file, 'utf-8');\n35:     } catch {\n36:       return null;\n37:     }\n38:     let parsed: unknown;\n39:     try {\n40:       parsed = parseJsonc(raw);\n41:     } catch (err) {\n42:       // паритет с ClaudeAdapter: ошибки парсинга — UserFacingError, не сырой SyntaxError\n43:       throw new UserFacingError(`${file} is not valid JSONC: ${err instanceof Error ? err.message : err}`);\n44:     }\n45:     return asConfig(parsed, file);\n46:   }\n47: \n48:   async writeConfig(projectRoot: string, cmd: McpCommand): Promise<'written' | 'replaced' | 'unchanged'> {\n49:     const file = this.configFile(projectRoot);\n50:     const cfg = (await this.readConfig(projectRoot)) ?? {};\n51:     const mcp = asRecord(cfg.mcp) ?? {};\n52:     // каноническая проекция McpCommand в формат opencode: command — массив\n53:     const desired = { type: 'local', command: [cmd.command, ...cmd.args], enabled: true };\n54:     if (JSON.stringify(mcp.wolf) === JSON.stringify(desired)) return 'unchanged';\n55:     const replaced = mcp.wolf !== undefined;\n56:     mcp.wolf = desired;\n57:     cfg.mcp = mcp;\n58:     await writeFileAtomic(file, JSON.stringify(cfg, null, 2) + '\\n');\n59:     return replaced ? 'replaced' : 'written';\n60:   }\n61: \n62:   async removeWolf(projectRoot: string): Promise<boolean> {\n63:     const file = this.configFile(projectRoot);\n64:     const cfg = await this.readConfig(projectRoot);\n65:     if (cfg === null) return false;\n66:     const mcp = asRecord(cfg.mcp);\n67:     if (mcp === undefined || mcp.wolf === undefined) return false;\n68:     delete mcp.wolf;\n69:     if (Object.keys(mcp).length === 0) delete cfg.mcp;\n70:     else cfg.mcp = mcp;\n71:     await writeFileAtomic(file, JSON.stringify(cfg, null, 2) + '\\n');\n72:     return true;\n73:   }\n74: }\n75: \n76: function asRecord(value: unknown): Record<string, unknown> | undefined {\n77:   return value !== null && typeof value === 'object' && !Array.isArray(value)\n78:     ? (value as Record<string, unknown>)\n79:     : undefined;\n80: }\n81: \n82: function asConfig(value: unknown, file: string): PlatformConfig {\n83:   const cfg = asRecord(value);\n84:   if (cfg === undefined) {\n85:     throw new UserFacingError(`${file} is not a JSON object — refusing to touch it`);\n86:   }\n87:   return cfg;\n88: }\n\n(End of file - total 88 lines)\n</content>","metadata":{"preview":"import * as fs from 'fs/promises';\nimport { existsSync } from 'fs';\nimport { join } from 'path';\nimport { PlatformAdapter, McpCommand, PlatformConfig } from '../../ports/platform-adapter.port.js';\nimport { parseJsonc } from './jsonc.js';\nimport { writeFileAtomic } from '../fs/markdown-memory-store.js';\nimport { UserFacingError } from '../../domain/errors.js';\n\n// ponytail: комментарии в opencode.jsonc теряются при rewrite (plain JSON валиден как JSONC);\n// сохранение комментариев = AST-редактор, YAGNI до запроса.\nexport class OpencodeAdapter implements PlatformAdapter {\n  readonly id = 'opencode';\n\n  detect(projectRoot: string): boolean {\n    return (\n      existsSync(join(projectRoot, 'opencode.json')) ||\n      existsSync(join(projectRoot, 'opencode.jsonc')) ||\n      existsSync(join(projectRoot, '.opencode'))\n    );\n  }","truncated":false,"loaded":[],"display":{"type":"file","path":"/tmp/wolfeval-v1/aa/A1/src/adapters/platforms/opencode-adapter.ts","text":"import * as fs from 'fs/promises';\nimport { existsSync } from 'fs';\nimport { join } from 'path';\nimport { PlatformAdapter, McpCommand, PlatformConfig } from '../../ports/platform-adapter.port.js';\nimport { parseJsonc } from './jsonc.js';\nimport { writeFileAtomic } from '../fs/markdown-memory-store.js';\nimport { UserFacingError } from '../../domain/errors.js';\n\n// ponytail: комментарии в opencode.jsonc теряются при rewrite (plain JSON валиден как JSONC);\n// сохранение комментариев = AST-редактор, YAGNI до запроса.\nexport class OpencodeAdapter implements PlatformAdapter {\n  readonly id = 'opencode';\n\n  detect(projectRoot: string): boolean {\n    return (\n      existsSync(join(projectRoot, 'opencode.json')) ||\n      existsSync(join(projectRoot, 'opencode.jsonc')) ||\n      existsSync(join(projectRoot, '.opencode'))\n    );\n  }\n\n  /** Существующий конфиг (jsonc — только если нет json); для новой установки — opencode.json. */\n  private configFile(projectRoot: string): string {\n    if (existsSync(join(projectRoot, 'opencode.jsonc')) && !existsSync(join(projectRoot, 'opencode.json'))) {\n      return join(projectRoot, 'opencode.jsonc');\n    }\n    return join(projectRoot, 'opencode.json');\n  }\n\n  async readConfig(projectRoot: string): Promise<PlatformConfig | null> {\n    const file = this.configFile(projectRoot);\n    let raw: string | null = null;\n    try {\n      raw = await fs.readFile(file, 'utf-8');\n    } catch {\n      return null;\n    }\n    let parsed: unknown;\n    try {\n      parsed = parseJsonc(raw);\n    } catch (err) {\n      // паритет с ClaudeAdapter: ошибки парсинга — UserFacingError, не сырой SyntaxError\n      throw new UserFacingError(`${file} is not valid JSONC: ${err instanceof Error ? err.message : err}`);\n    }\n    return asConfig(parsed, file);\n  }\n\n  async writeConfig(projectRoot: string, cmd: McpCommand): Promise<'written' | 'replaced' | 'unchanged'> {\n    const file = this.configFile(projectRoot);\n    const cfg = (await this.readConfig(projectRoot)) ?? {};\n    const mcp = asRecord(cfg.mcp) ?? {};\n    // каноническая проекция McpCommand в формат opencode: command — массив\n    const desired = { type: 'local', command: [cmd.command, ...cmd.args], enabled: true };\n    if (JSON.stringify(mcp.wolf) === JSON.stringify(desired)) return 'unchanged';\n    const replaced = mcp.wolf !== undefined;\n    mcp.wolf = desired;\n    cfg.mcp = mcp;\n    await writeFileAtomic(file, JSON.stringify(cfg, null, 2) + '\\n');\n    return replaced ? 'replaced' : 'written';\n  }\n\n  async removeWolf(projectRoot: string): Promise<boolean> {\n    const file = this.configFile(projectRoot);\n    const cfg = await this.readConfig(projectRoot);\n    if (cfg === null) return false;\n    const mcp = asRecord(cfg.mcp);\n    if (mcp === undefined || mcp.wolf === undefined) return false;\n    delete mcp.wolf;\n    if (Object.keys(mcp).length === 0) delete cfg.mcp;\n    else cfg.mcp = mcp;\n    await writeFileAtomic(file, JSON.stringify(cfg, null, 2) + '\\n');\n    return true;\n  }\n}\n\nfunction asRecord(value: unknown): Record<string, unknown> | undefined {\n  return value !== null && typeof value === 'object' && !Array.isArray(value)\n    ? (value as Record<string, unknown>)\n    : undefined;\n}\n\nfunction asConfig(value: unknown, file: string): PlatformConfig {\n  const cfg = asRecord(value);\n  if (cfg === undefined) {\n    throw new UserFacingError(`${file} is not a JSON object — refusing to touch it`);\n  }\n  return cfg;\n}","lineStart":1,"lineEnd":88,"totalLines":88,"truncated":false}},"title":"../../../../../tmp/wolfeval-v1/aa/A1/src/adapters/platforms/opencode-adapter.ts","time":{"start":1788633782689,"end":1788633782707}},"id":"prt_072e1999d001DJMGSclHdErkbP","sessionID":"ses_f8d1f048bffeWi62luRotMafVq","messageID":"msg_072e17b93001SL07mirsq4jKW9"}}
