t: MCP-конфиги не пишем никогда). */\n36:   npx: boolean;\n37:   scanDeps: Parameters<typeof scanProject>[0];\n38:   /** Проставить маркер версии схемы (writeSchemaVersionIfAbsent). */\n39:   markSchemaCurrent: (baseDir: string) => Promise<void>;\n40:   baseSet?: BaseSetDeps;\n41: }\n42: \n43: export interface PlatformInitOutcome {\n44:   platform: string;\n45:   action: 'written' | 'replaced' | 'unchanged' | 'skipped' | 'removed';\n46:   reason?: string;\n47: }\n48: \n49: export interface InitProjectResult {\n50:   npx: boolean;\n51:   documentCount: number;\n52:   platformOutcomes: PlatformInitOutcome[];\n53:   baseSetOutcomes: BaseSetOutcome[];\n54: }\n55: \n56: const PROJECT_ROOT_MARKERS = ['package.json', '.git', 'pyproject.toml', 'go.mod', 'Cargo.toml', 'README.md'];\n57: \n58: export function looksLikeProjectRoot(dir: string): boolean {\n59:   return PROJECT_ROOT_MARKERS.some((marker) => existsSync(join(dir, marker)));\n60: }\n61: \n62: /**\n63:  * `wolf init` (спека §3, уровень 1): идемпотентный, неинтерактивный.\n64:  * Скелет (ensure) → маркер схемы → лёгкий scan (document-ref'ы идемпотентны; глубокое\n65:  * наполнение — отдельная команда `wolf bootstrap`) → платформы → реестр.\n66:  */\n67: export async function initProject(\n68:   deps: InitProjectDeps,\n69:   baseDir: string,\n70:   opts: { platformIds?: string[] } = {}\n71: ): Promise<InitProjectResult> {\n72:   if (!looksLikeProjectRoot(baseDir)) {\n73:     throw new UserFacingError(\n74:       'Not a project root (no package.json/.git/pyproject.toml/go.mod/Cargo.toml/README.md found). cd into your project first.'\n75:     );\n76:   }\n77: \n78:   await deps.initializer.initialize(baseDir);\n79:   await deps.markSchemaCurrent(baseDir);\n80:   const scan = await scanProject(deps.scanDeps, baseDir);\n81: \n82:   // Платформы детектируем ДО рендера базового набора: рендер создаёт .opencode/,\n83:   // и детект после него принял бы свежесозданный каталог за маркер платформы (T14).\n84:   const platformOutcomes: PlatformInitOutcome[] = [];\n85:   if (deps.npx) {\n86:     // try-out: память создаём, конфиги — никогда (спека §3, npx-путь)\n87:     platformOutcomes.push({ platform: 'npx', action: 'skipped', reason: 'npx try-out never writes MCP configs' });\n88:   } else if (opts.platformIds !== undefined) {\n89:     // явный список ЗАМЕНЯЕТ набор: wolf-записи платформ вне списка удаляются (спека §3)\n90:     const wanted = new Set(opts.platformIds);\n91:     for (const adapter of deps.adapters) {\n92:       if (wanted.has(adapter.id)) {\n93:         platformOutcomes.push({ platform: adapter.id, action: await adapter.writeConfig(baseDir, deps.mcpCommand) });\n94:       } else if (adapter.detect(baseDir)) {\n95:         const removed = await adapter.removeWolf(baseDir);\n96:         platformOutcomes.push({\n97:           platform: adapter.id,\n98:           action: 'removed',\n99:           reason: removed ? 'wolf entry removed (--platform list)' : 'no wolf entry',\n100:         });\n101:       }\n102:     }\n103:   } else {\n104:     // авто-детект: объединение найденных; «платформа не детектирована» — warning + skip\n105:     const detected = deps.adapters.filter((a) => a.detect(baseDir));\n106:     if (detected.length === 0) {\n107:       platformOutcomes.push({\n108:         platform: 'none',\n109:         action: 'skipped',\n110:         reason: 'no platform detected; use --platform opencode|claude',\n111:       });\n112:     } else {\n113:       for (const adapter of detected) {\n114:         platformOutcomes.push({ platform: adapter.id, action: await adapter.writeConfig(baseDir, deps.mcpCommand) });\n115:       }\n116:     }\n117:   }\n118: \n119:   const baseSetOutcomes: BaseSetOutcome[] = [];\n120:   if (deps.baseSet) {\n121:     if (deps.npx) {\n122:       baseSetOutcomes.push({ file: '(base set)', action: 'skipped', reason: 'npx try-out не пишет набор (спека §7)' });\n123:     } else {\n124:       baseSetOutcomes.push(...(await deps.baseSet.render(baseDir)));\n125:       baseSetOutcomes.push(...(await deps.baseSet.seed(baseDir)));\n126:     }\n127:   }\n128: \n129:   await deps.registry.register(baseDir, CURRENT_SCHEMA_VERSION);\n130: \n131:   return { npx: deps.npx, documentCount: scan.documents.length, platformOutcomes, baseSetOutcomes };\n132: }\n133: \n134: /**\n135:  * §6: повреждённый .wolf → неинтерактивное восстановление:\n136:  * битый yaml → бэкап в .wolf/backup/<ts>/ + дефолтный рендер.\n137:  * Валидный yaml-объект и отсутствующий конфиг → no-op.\n138:  */\n139: export async function recreateConfig(baseDir: string): Promise<void> {\n140:   const cfgPath = configPath(baseDir);\n141:   let raw: string | null = null;\n142:   try {\n143:     raw = await fs.readFile(cfgPath, 'utf-8');\n144:   } catch {\n145:     return; // конфига нет — init создаст скелет\n146:   }\n147:   // валидный конфиг не трогаем: --recreate лечит только повреждённый yaml\n148:   let parsed: unknown;\n149:   try {\n150:     parsed = yaml.load(raw);\n151:   } catch {\n152:     parsed = undefined; // битый yaml — восстанавливаем ниже\n153:   }\n154:   if (parsed !== null && typeof parsed === 'object') return;\n155: \n156:   const stamp = new Date().toISOString().replace(/[:.]/g, '-');\n157:   const backupDir = join(baseDir, '.wolf', 'backup', stamp);\n158:   await fs.mkdir(backupDir, { recursive: true });\n159:   await fs.copyFile(cfgPath, join(backupDir, 'config.yaml'));\n160:   await writeFileAtomic(cfgPath, renderConfigYaml(null));\n161: }\n\n(End of file - total 161 lines)\n</content>","metadata":{"preview":"import { existsSync } from 'fs';\nimport * as fs from 'fs/promises';\nimport { join } from 'path';\nimport yaml from 'js-yaml';\nimport { ProjectInitializer } from '../../ports/project-initializer.port.js';\nimport { PlatformAdapter, McpCommand } from '../../ports/platform-adapter.port.js';\nimport { scanProject } from './scan-project.js';\nimport { writeSchemaVersionIfAbsent, CURRENT_SCHEMA_VERSION } from '../../adapters/fs/schema-version.js';\nimport { renderConfigYaml } from '../../adapters/fs/config-file.js';\nimport { configPath } from '../../adapters/fs/project-paths.js';\nimport { writeFileAtomic } from '../../adapters/fs/markdown-memory-store.js';\nimport { UserFacingError } from '../../domain/errors.js';\nimport { RenderAction } from '../../ports/base-set-renderer.port.js';\n\n/** Минимальный контракт реестра для init (структурно совместим с ProjectsRegistry). */\nexport interface ProjectRegistry {\n  register(path: string, schemaVersion: number): Promise<void>;\n}\n\nexport interface BaseSetOutcome {","truncated":false,"loaded":[],"display":{"type":"file","path":"/tmp/wolfeval-v1/aa/A1/src/app/use-cases/init-project.ts","text":"import { existsSync } from 'fs';\nimport * as fs from 'fs/promises';\nimport { join } from 'path';\nimport yaml from 'js-yaml';\nimport { ProjectInitializer } from '../../ports/project-initializer.port.js';\nimport { PlatformAdapter, McpCommand } from '../../ports/platform-adapter.port.js';\nimport { scanProject } from './scan-project.js';\nimport { writeSchemaVersionIfAbsent, CURRENT_SCHEMA_VERSION } from '../../adapters/fs/schema-version.js';\nimport { renderConfigYaml } from '../../adapters/fs/config-file.js';\nimport { configPath } from '../../adapters/fs/project-paths.js';\nimport { writeFileAtomic } from '../../adapters/fs/markdown-memory-store.js';\nimport { UserFacingError } from '../../domain/errors.js';\nimport { RenderAction } from '../../ports/base-set-renderer.port.js';\n\n/** Минимальный контракт реестра для init (структурно совместим с ProjectsRegistry). */\nexport interface ProjectRegistry {\n  register(path: string, schemaVersion: number): Promise<void>;\n}\n\nexport interface BaseSetOutcome {\n  file: string;\n  action: RenderAction; // тот же тип, minor 5\n  reason?: string;\n}\nexport interface BaseSetDeps {\n  render: (baseDir: string) => Promise<BaseSetOutcome[]>;\n  seed: (baseDir: string) => Promise<BaseSetOutcome[]>;\n}\n\nexport interface InitProjectDeps {\n  initializer: ProjectInitializer;\n  registry: ProjectRegistry;\n  adapters: PlatformAdapter[];\n  mcpCommand: McpCommand;\n  /** true, когда бинарник запущен через npx (try-out: MCP-конфиги не пишем никогда). */\n  npx: boolean;\n  scanDeps: Parameters<typeof scanProject>[0];\n  /** Проставить маркер версии схемы (writeSchemaVersionIfAbsent). */\n  markSchemaCurrent: (baseDir: string) => Promise<void>;\n  baseSet?: BaseSetDeps;\n}\n\nexport interface PlatformInitOutcome {\n  platform: string;\n  action: 'written' | 'replaced' | 'unchanged' | 'skipped' | 'removed';\n  reason?: string;\n}\n\nexport interface InitProjectResult {\n  npx: boolean;\n  documentCount: number;\n  platformOutcomes: PlatformInitOutcome[];\n  baseSetOutcomes: BaseSetOutcome[];\n}\n\nconst PROJECT_ROOT_MARKERS = ['package.json', '.git', 'pyproject.toml', 'go.mod', 'Cargo.toml', 'README.md'];\n\nexport function looksLikeProjectRoot(dir: string): boolean {\n  return PROJECT_ROOT_MARKERS.some((marker) => existsSync(join(dir, marker)));\n}\n\n/**\n * `wolf init` (спека §3, уровень 1): идемпотентный, неинтерактивный.\n * Скелет (ensure) → маркер схемы → лёгкий scan (document-ref'ы идемпотентны; глубокое\n * наполнение — отдельная команда `wolf bootstrap`) → платформы → реестр.\n */\nexport async function initProject(\n  deps: InitProjectDeps,\n  baseDir: string,\n  opts: { platformIds?: string[] } = {}\n): Promise<InitProjectResult> {\n  if (!looksLikeProjectRoot(baseDir)) {\n    throw new UserFacingError(\n      'Not a project root (no package.json/.git/pyproject.toml/go.mod/Cargo.toml/README.md found). cd into your project first.'\n    );\n  }\n\n  await deps.initializer.initialize(baseDir);\n  await deps.markSchemaCurrent(baseDir);\n  const scan = await scanProject(deps.scanDeps, baseDir);\n\n  // Платформы детектируем ДО рендера базового набора: рендер создаёт .opencode/,\n  // и детект после него принял бы свежесозданный каталог за маркер платформы (T14).\n  const platformOutcomes: PlatformInitOutcome[] = [];\n  if (deps.npx) {\n    // try-out: память создаём, конфиги — никогда (спека §3, npx-путь)\n    platformOutcomes.push({ platform: 'npx', action: 'skipped', reason: 'npx try-out never writes MCP configs' });\n  } else if (opts.platformIds !== undefined) {\n    // явный список ЗАМЕНЯЕТ набор: wolf-записи платформ вне списка удаляются (спека §3)\n    const wanted = new Set(opts.platformIds);\n    for (const adapter of deps.adapters) {\n      if (wanted.has(adapter.id)) {\n        platformOutcomes.push({ platform: adapter.id, action: await adapter.writeConfig(baseDir, deps.mcpCommand) });\n      } else if (adapter.detect(baseDir)) {\n        const removed = await adapter.removeWolf(baseDir);\n        platformOutcomes.push({\n          platform: adapter.id,\n          action: 'removed',\n          reason: removed ? 'wolf entry removed (--platform list)' : 'no wolf entry',\n        });\n      }\n    }\n  } else {\n    // авто-детект: объединение найденных; «платформа не детектирована» — warning + skip\n    const detected = deps.adapters.filter((a) => a.detect(baseDir));\n    if (detected.length === 0) {\n      platformOutcomes.push({\n        platform: 'none',\n        action: 'skipped',\n        reason: 'no platform detected; use --platform opencode|claude',\n      });\n    } else {\n      for (const adapter of detected) {\n        platformOutcomes.push({ platform: adapter.id, action: await adapter.writeConfig(baseDir, deps.mcpCommand) });\n      }\n    }\n  }\n\n  const baseSetOutcomes: BaseSetOutcome[] = [];\n  if (deps.baseSet) {\n    if (deps.npx) {\n      baseSetOutcomes.push({ file: '(base set)', action: 'skipped', reason: 'npx try-out не пишет набор (спека §7)' });\n    } else {\n      baseSetOutcomes.push(...(await deps.baseSet.render(baseDir)));\n      baseSetOutcomes.push(...(await deps.baseSet.seed(baseDir)));\n    }\n  }\n\n  await deps.registry.register(baseDir, CURRENT_SCHEMA_VERSION);\n\n  return { npx: deps.npx, documentCount: scan.documents.length, platformOutcomes, baseSetOutcomes };\n}\n\n/**\n * §6: повреждённый .wolf → неинтерактивное восстановление:\n * битый yaml → бэкап в .wolf/backup/<ts>/ + дефолтный рендер.\n * Валидный yaml-объект и отсутствующий конфиг → no-op.\n */\nexport async function recreateConfig(baseDir: string): Promise<void> {\n  const cfgPath = configPath(baseDir);\n  let raw: string | null = null;\n  try {\n    raw = await fs.readFile(cfgPath, 'utf-8');\n  } catch {\n    return; // конфига нет — init создаст скелет\n  }\n  // валидный конфиг не трогаем: --recreate лечит только повреждённый yaml\n  let parsed: unknown;\n  try {\n    parsed = yaml.load(raw);\n  } catch {\n    parsed = undefined; // битый yaml — восстанавливаем ниже\n  }\n  if (parsed !== null && typeof parsed === 'object') return;\n\n  const stamp = new Date().toISOString().replace(/[:.]/g, '-');\n  const backupDir = join(baseDir, '.wolf', 'backup', stamp);\n  await fs.mkdir(backupDir, { recursive: true });\n  await fs.copyFile(cfgPath, join(backupDir, 'config.yaml'));\n  await writeFileAtomic(cfgPath, renderConfigYaml(null));\n}","lineStart":1,"lineEnd":161,"totalLines":161,"truncated":false}},"title":"../../../../../tmp/wolfeval-v1/aa/A1/src/app/use-cases/init-project.ts","time":{"start":1788633774758,"end":1788633774766}},"id":"prt_072e17aa1001C6q3RoNfgfyMG4","sessionID":"ses_f8d1f048bffeWi62luRotMafVq","messageID":"msg_072e1630d001nNjFGYk07n4GC1"}}
