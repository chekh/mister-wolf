) return done(null, { stdout: RECAP_STDOUT });\n","exit":0,"truncated":false},"title":"head -12 tests/unit/wolf-session-start-plugin.test.ts","time":{"start":1788634408007,"end":1788634408046}},"id":"prt_072eb2440001mNKgjIEJ0XYMYg","sessionID":"ses_f8d1f048bffeWi62luRotMafVq","messageID":"msg_072eae483001Ip0p2wdW2TTuD9"}}
