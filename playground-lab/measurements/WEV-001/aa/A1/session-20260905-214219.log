й бинарь, никогда npx (спека §4). */\nexport const CANONICAL_MCP_COMMAND: McpCommand = { command: 'wolf', args: ['mcp'] };\n\n/** Все платформы v1. Новая платформа = адаптер в этот список, init не меняется. */\nexport const PLATFORM_ADAPTERS: PlatformAdapter[] = [new OpencodeAdapter(), new ClaudeAdapter()];","lineStart":1,"lineEnd":9,"totalLines":9,"truncated":false}},"title":"../../../../../tmp/wolfeval-v1/aa/A1/src/adapters/platforms/index.ts","time":{"start":1788633782696,"end":1788633782710}},"id":"prt_072e199a30013Hxc0sA3VfzXZE","sessionID":"ses_f8d1f048bffeWi62luRotMafVq","messageID":"msg_072e17b93001SL07mirsq4jKW9"}}
