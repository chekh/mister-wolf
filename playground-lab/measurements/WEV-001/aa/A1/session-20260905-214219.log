{"type":"tool_use","timestamp":1788633774560,"sessionID":"ses_f8d1f048bffeWi62luRotMafVq","part":{"type":"tool","tool":"read","callID":"call_569f49782d594526b2c549e7","state":{"status":"completed","input":{"filePath":"/tmp/wolfeval-v1/aa/A1/src/adapters/cli/commands/memory-init.ts"},"output":"<path>/tmp/wolfeval-v1/aa/A1/src/adapters/cli/commands/memory-init.ts</path>\n<type>file</type>\n<content>\n1: import { Command } from 'commander';\n2: import { join } from 'path';\n3: import { readFileSync, readdirSync, existsSync } from 'fs';\n4: import { createCliContainer } from '../../../bootstrap/container.js';\n5: import { ProjectsRegistry } from '../../../adapters/fs/projects-registry.js';\n6: import { wolfUserConfigDir } from '../../../adapters/fs/user-config.js';\n7: import { PLATFORM_ADAPTERS, CANONICAL_MCP_COMMAND } from '../../../adapters/platforms/index.js';\n8: import { writeSchemaVersionIfAbsent } from '../../../adapters/fs/schema-version.js';\n9: import { ensureCurrentSchema } from '../../../adapters/fs/schema-guard.js';\n10: import { initProject, recreateConfig } from '../../../app/use-cases/init-project.js';\n11: import { OpencodeBaseSetRenderer } from '../../../adapters/render/opencode/opencode-renderer.js';\n12: import { templatesRoot, harnessTemplatesRoot } from '../../../adapters/render/templates-root.js';\n13: import { seedBasePlaybooks } from '../../../app/use-cases/seed-base-playbooks.js';\n14: import { addMemoryObject } from '../../../app/use-cases/add-memory-object.js';\n15: import { isNpxRun } from '../../../domain/npx.js';\n16: import { UserFacingError } from '../../../domain/errors.js';\n17: \n18: export function memoryInitCommand(): Command {\n19:   return new Command('init')\n20:     .description('Initialize Mr. Wolf memory for this project (idempotent, non-interactive)')\n21:     .option('--platform <ids>', 'explicit platform list (comma-separated: opencode,claude); replaces the current set')\n22:     .option('--recreate', 'backup a corrupted .wolf/config.yaml and re-create it from defaults', false)\n23:     .action(async (options: { platform?: string; recreate?: boolean }) => {\n24:       const baseDir = process.cwd();\n25:       if (options.recreate) {\n26:         await recreateConfig(baseDir);\n27:         // восстановление = приведение к валидному СОСТОЯНИЮ, а не тихий штамп маркера ниже:\n28:         // легаси-схема (1/без маркера) мигрирует здесь (layout + маркер), иначе markSchemaCurrent\n29:         // дописал бы v2 без layout-миграции и objects/ остался бы осиротевшим навсегда;\n30:         // схема из будущего — честный отказ «обнови wolf» (спека §3), а не даунгрейд 99→2\n31:         await ensureCurrentSchema(baseDir);\n32:       }\n33: \n34:       let platformIds: string[] | undefined;\n35:       if (options.platform !== undefined) {\n36:         platformIds = options.platform\n37:           .split(',')\n38:           .map((s) => s.trim())\n39:           .filter((s) => s !== '');\n40:         const known = new Set(PLATFORM_ADAPTERS.map((a) => a.id));\n41:         const unknown = platformIds.filter((id) => !known.has(id));\n42:         if (unknown.length > 0) {\n43:           throw new UserFacingError(`Unknown platform(s): ${unknown.join(', ')} (known: ${[...known].join(', ')})`);\n44:         }\n45:       }\n46: \n47:       const { initializer, store, log, clock, idGen, scanner, index, lock, declarations } = createCliContainer(baseDir);\n48:       const registry = new ProjectsRegistry(wolfUserConfigDir());\n49: \n50:       const tplPlaybooks = join(templatesRoot(), 'playbooks');\n51:       const playbookFiles = new Map<string, string>();\n52:       if (existsSync(tplPlaybooks)) {\n53:         for (const f of readdirSync(tplPlaybooks)) {\n54:           if (f.endsWith('.md')) playbookFiles.set(f, readFileSync(join(tplPlaybooks, f), 'utf-8'));\n55:         }\n56:       }\n57:       // ListFilters поддерживает type (memory-store.port.ts) — фильтр на уровне порта (правка r2)\n58:       const existing = await store.list({ type: 'playbook' });\n59:       const seededOwners = new Set(\n60:         existing.map((o) => (o as { owner_skill?: string }).owner_skill).filter((x): x is string => Boolean(x))\n61:       );\n62:       const addFn = (input: Parameters<typeof addMemoryObject>[1]) =>\n63:         addMemoryObject({ store, log, clock, idGen, index, lock, declarations }, input);\n64: \n65:       const result = await initProject(\n66:         {\n67:           initializer,\n68:           registry,\n69:           adapters: PLATFORM_ADAPTERS,\n70:           mcpCommand: CANONICAL_MCP_COMMAND,\n71:           npx: isNpxRun(),\n72:           scanDeps: { store, log, clock, idGen, scanner, index, lock },\n73:           markSchemaCurrent: (dir) => writeSchemaVersionIfAbsent(dir),\n74:           baseSet: {\n75:             render: (dir) =>\n76:               new OpencodeBaseSetRenderer(templatesRoot(), {\n77:                 harnessTemplatesRoot: harnessTemplatesRoot('opencode'),\n78:               }).renderBaseSet(dir),\n79:             seed: () =>\n80:               seedBasePlaybooks({\n81:                 files: playbookFiles,\n82:                 add: async (i) => {\n83:                   await addFn(i);\n84:                   return {};\n85:                 },\n86:                 isSeeded: async (owner) => seededOwners.has(owner),\n87:               }),\n88:           },\n89:         },\n90:         baseDir,\n91:         { platformIds }\n92:       );\n93: \n94:       console.log('# wolf init');\n95:       console.log(`- memory skeleton: ensured (${join(baseDir, '.wolf')})`);\n96:       console.log(`- scan: ${result.documentCount} document(s) registered`);\n97:       for (const o of result.baseSetOutcomes)\n98:         console.log(`- base set: ${o.file} ${o.action}${o.reason ? ` — ${o.reason}` : ''}`);\n99:       for (const outcome of result.platformOutcomes) {\n100:         const label =\n101:           outcome.platform === 'none' || outcome.platform === 'npx'\n102:             ? 'platform configs'\n103:             : `platform ${outcome.platform}`;\n104:         console.log(`- ${label}: ${outcome.action}${outcome.reason ? ` — ${outcome.reason}` : ''}`);\n105:       }\n106:       if (result.npx) {\n107:         console.log(\n108:           '  → this was an npx try-out; to connect your platform: npm install -g mister-wolf, then re-run: wolf init'\n109:         );\n110:       } else {\n111:         console.log('Restart your agent platform to pick up the MCP server.');\n112:         if (result.platformOutcomes.some((o) => o.platform === 'claude' && o.action !== 'removed')) {\n113:           console.log('Claude Code: approve the project-scoped MCP server on first start.');\n114:         }\n115:       }\n116:       console.log(`Project registered: ${join(wolfUserConfigDir(), 'projects.yaml')}`);\n117: \n118:       // §3: ненулевой exit — только если при явном --platform не записано ни одного конфига\n119:       const wroteSomething = result.platformOutcomes.some((o) =>\n120:         ['written', 'replaced', 'unchanged'].includes(o.action)\n121:       );\n122:       if (platformIds !== undefined && !wroteSomething) process.exitCode = 1;\n123:     });\n124: }\n\n(End of file - total 124 lines)\n</content>","metadata":{"preview":"import { Command } from 'commander';\nimport { join } from 'path';\nimport { readFileSync, readdirSync, existsSync } from 'fs';\nimport { createCliContainer } from '../../../bootstrap/container.js';\nimport { ProjectsRegistry } from '../../../adapters/fs/projects-registry.js';\nimport { wolfUserConfigDir } from '../../../adapters/fs/user-config.js';\nimport { PLATFORM_ADAPTERS, CANONICAL_MCP_COMMAND } from '../../../adapters/platforms/index.js';\nimport { writeSchemaVersionIfAbsent } from '../../../adapters/fs/schema-version.js';\nimport { ensureCurrentSchema } from '../../../adapters/fs/schema-guard.js';\nimport { initProject, recreateConfig } from '../../../app/use-cases/init-project.js';\nimport { OpencodeBaseSetRenderer } from '../../../adapters/render/opencode/opencode-renderer.js';\nimport { templatesRoot, harnessTemplatesRoot } from '../../../adapters/render/templates-root.js';\nimport { seedBasePlaybooks } from '../../../app/use-cases/seed-base-playbooks.js';\nimport { addMemoryObject } from '../../../app/use-cases/add-memory-object.js';\nimport { isNpxRun } from '../../../domain/npx.js';\nimport { UserFacingError } from '../../../domain/errors.js';\n\nexport function memoryInitCommand(): Command {\n  return new Command('init')\n    .description('Initialize Mr. Wolf memory for this project (idempotent, non-interactive)')","truncated":false,"loaded":[],"display":{"type":"file","path":"/tmp/wolfeval-v1/aa/A1/src/adapters/cli/commands/memory-init.ts","text":"import { Command } from 'commander';\nimport { join } from 'path';\nimport { readFileSync, readdirSync, existsSync } from 'fs';\nimport { createCliContainer } from '../../../bootstrap/container.js';\nimport { ProjectsRegistry } from '../../../adapters/fs/projects-registry.js';\nimport { wolfUserConfigDir } from '../../../adapters/fs/user-config.js';\nimport { PLATFORM_ADAPTERS, CANONICAL_MCP_COMMAND } from '../../../adapters/platforms/index.js';\nimport { writeSchemaVersionIfAbsent } from '../../../adapters/fs/schema-version.js';\nimport { ensureCurrentSchema } from '../../../adapters/fs/schema-guard.js';\nimport { initProject, recreateConfig } from '../../../app/use-cases/init-project.js';\nimport { OpencodeBaseSetRenderer } from '../../../adapters/render/opencode/opencode-renderer.js';\nimport { templatesRoot, harnessTemplatesRoot } from '../../../adapters/render/templates-root.js';\nimport { seedBasePlaybooks } from '../../../app/use-cases/seed-base-playbooks.js';\nimport { addMemoryObject } from '../../../app/use-cases/add-memory-object.js';\nimport { isNpxRun } from '../../../domain/npx.js';\nimport { UserFacingError } from '../../../domain/errors.js';\n\nexport function memoryInitCommand(): Command {\n  return new Command('init')\n    .description('Initialize Mr. Wolf memory for this project (idempotent, non-interactive)')\n    .option('--platform <ids>', 'explicit platform list (comma-separated: opencode,claude); replaces the current set')\n    .option('--recreate', 'backup a corrupted .wolf/config.yaml and re-create it from defaults', false)\n    .action(async (options: { platform?: string; recreate?: boolean }) => {\n      const baseDir = process.cwd();\n      if (options.recreate) {\n        await recreateConfig(baseDir);\n        // восстановление = приведение к валидному СОСТОЯНИЮ, а не тихий штамп маркера ниже:\n        // легаси-схема (1/без маркера) мигрирует здесь (layout + маркер), иначе markSchemaCurrent\n        // дописал бы v2 без layout-миграции и objects/ остался бы осиротевшим навсегда;\n        // схема из будущего — честный отказ «обнови wolf» (спека §3), а не даунгрейд 99→2\n        await ensureCurrentSchema(baseDir);\n      }\n\n      let platformIds: string[] | undefined;\n      if (options.platform !== undefined) {\n        platformIds = options.platform\n          .split(',')\n          .map((s) => s.trim())\n          .filter((s) => s !== '');\n        const known = new Set(PLATFORM_ADAPTERS.map((a) => a.id));\n        const unknown = platformIds.filter((id) => !known.has(id));\n        if (unknown.length > 0) {\n          throw new UserFacingError(`Unknown platform(s): ${unknown.join(', ')} (known: ${[...known].join(', ')})`);\n        }\n      }\n\n      const { initializer, store, log, clock, idGen, scanner, index, lock, declarations } = createCliContainer(baseDir);\n      const registry = new ProjectsRegistry(wolfUserConfigDir());\n\n      const tplPlaybooks = join(templatesRoot(), 'playbooks');\n      const playbookFiles = new Map<string, string>();\n      if (existsSync(tplPlaybooks)) {\n        for (const f of readdirSync(tplPlaybooks)) {\n          if (f.endsWith('.md')) playbookFiles.set(f, readFileSync(join(tplPlaybooks, f), 'utf-8'));\n        }\n      }\n      // ListFilters поддерживает type (memory-store.port.ts) — фильтр на уровне порта (правка r2)\n      const existing = await store.list({ type: 'playbook' });\n      const seededOwners = new Set(\n        existing.map((o) => (o as { owner_skill?: string }).owner_skill).filter((x): x is string => Boolean(x))\n      );\n      const addFn = (input: Parameters<typeof addMemoryObject>[1]) =>\n        addMemoryObject({ store, log, clock, idGen, index, lock, declarations }, input);\n\n      const result = await initProject(\n        {\n          initializer,\n          registry,\n          adapters: PLATFORM_ADAPTERS,\n          mcpCommand: CANONICAL_MCP_COMMAND,\n          npx: isNpxRun(),\n          scanDeps: { store, log, clock, idGen, scanner, index, lock },\n          markSchemaCurrent: (dir) => writeSchemaVersionIfAbsent(dir),\n          baseSet: {\n            render: (dir) =>\n              new OpencodeBaseSetRenderer(templatesRoot(), {\n                harnessTemplatesRoot: harnessTemplatesRoot('opencode'),\n              }).renderBaseSet(dir),\n            seed: () =>\n              seedBasePlaybooks({\n                files: playbookFiles,\n                add: async (i) => {\n                  await addFn(i);\n                  return {};\n                },\n                isSeeded: async (owner) => seededOwners.has(owner),\n              }),\n          },\n        },\n        baseDir,\n        { platformIds }\n      );\n\n      console.log('# wolf init');\n      console.log(`- memory skeleton: ensured (${join(baseDir, '.wolf')})`);\n      console.log(`- scan: ${result.documentCount} document(s) registered`);\n      for (const o of result.baseSetOutcomes)\n        console.log(`- base set: ${o.file} ${o.action}${o.reason ? ` — ${o.reason}` : ''}`);\n      for (const outcome of result.platformOutcomes) {\n        const label =\n          outcome.platform === 'none' || outcome.platform === 'npx'\n            ? 'platform configs'\n            : `platform ${outcome.platform}`;\n        console.log(`- ${label}: ${outcome.action}${outcome.reason ? ` — ${outcome.reason}` : ''}`);\n      }\n      if (result.npx) {\n        console.log(\n          '  → this was an npx try-out; to connect your platform: npm install -g mister-wolf, then re-run: wolf init'\n        );\n      } else {\n        console.log('Restart your agent platform to pick up the MCP server.');\n        if (result.platformOutcomes.some((o) => o.platform === 'claude' && o.action !== 'removed')) {\n          console.log('Claude Code: approve the project-scoped MCP server on first start.');\n        }\n      }\n      console.log(`Project registered: ${join(wolfUserConfigDir(), 'projects.yaml')}`);\n\n      // §3: ненулевой exit — только если при явном --platform не записано ни одного конфига\n      const wroteSomething = result.platformOutcomes.some((o) =>\n        ['written', 'replaced', 'unchanged'].includes(o.action)\n      );\n      if (platformIds !== undefined && !wroteSomething) process.exitCode = 1;\n    });\n}","lineStart":1,"lineEnd":124,"totalLines":124,"truncated":false}},"title":"../../../../../tmp/wolfeval-v1/aa/A1/src/adapters/cli/commands/memory-init.ts","time":{"start":1788633774535,"end":1788633774557}},"id":"prt_072e179c3001epRJ0f3EX8Ubfb","sessionID":"ses_f8d1f048bffeWi62luRotMafVq","messageID":"msg_072e1630d001nNjFGYk07n4GC1"}}
