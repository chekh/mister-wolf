{"type":"text","timestamp":1788633800778,"sessionID":"ses_f8d1f048bffeWi62luRotMafVq","part":{"id":"prt_072e1e020001InvcclfqpXQR69","messageID":"msg_072e19aa3001h5qBi7QJCTp77N","sessionID":"ses_f8d1f048bffeWi62luRotMafVq","type":"text","text":"Ключевая находка: `detect()` смотрит маркеры `opencode.json`/`opencode.jsonc`/`.opencode`, а детект идёт ДО рендера базового набора. Проверяю, что создаёт рендер базового набора, и смотрю существующие e2e-тесты.","time":{"start":1788633800736,"end":1788633800773}}}
{"type":"tool_use","timestamp":1788633800801,"sessionID":"ses_f8d1f048bffeWi62luRotMafVq","part":{"type":"tool","tool":"read","callID":"call_cf64ea42714748b0a67abf34","state":{"status":"completed","input":{"filePath":"/tmp/wolfeval-v1/aa/A1/src/adapters/render/opencode/opencode-renderer.ts"},"output":"<path>/tmp/wolfeval-v1/aa/A1/src/adapters/render/opencode/opencode-renderer.ts</path>\n<type>file</type>\n<content>\n1: // src/adapters/render/opencode/opencode-renderer.ts\n2: import { existsSync, readFileSync, readdirSync, statSync } from 'fs';\n3: import { basename, join, relative } from 'path';\n4: import { mkdir, writeFile } from 'fs/promises';\n5: import { BaseSetRenderer, BakeResolver, RenderOutcome } from '../../../ports/base-set-renderer.port.js';\n6: import { OPENCODE_MANIFEST, substitute } from '../manifest.js';\n7: import { insertStamp, parseStamp } from '../stamp.js';\n8: import { wolfVersion } from '../templates-root.js';\n9: \n10: const NEUTRAL_DIRS = ['agents', 'skills', 'commands'] as const;\n11: const LAYOUT: Record<(typeof NEUTRAL_DIRS)[number], string> = {\n12:   agents: '.opencode/agents',\n13:   skills: '.opencode/skills',\n14:   commands: '.opencode/command',\n15: };\n16: \n17: interface TemplateFile {\n18:   tplPath: string;\n19:   /** Цель посчитана в templateFiles: корень зависит от происхождения шаблона (NC1). */\n20:   target: string;\n21:   baseName: string;\n22: }\n23: \n24: export class OpencodeBaseSetRenderer implements BaseSetRenderer {\n25:   id = 'opencode';\n26: \n27:   constructor(\n28:     private readonly baseTemplatesRoot: string,\n29:     private readonly opts: { harnessTemplatesRoot?: string; setVersion?: string } = {}\n30:   ) {}\n31: \n32:   private get setVersion(): string {\n33:     return this.opts.setVersion ?? wolfVersion();\n34:   }\n35: \n36:   /** NC1: harness-шаблоны резолвятся от СВОЕГО корня, не от baseTemplatesRoot. */\n37:   private *templateFiles(baseDir: string): Generator<TemplateFile> {\n38:     for (const dir of NEUTRAL_DIRS) {\n39:       const root = join(this.baseTemplatesRoot, dir);\n40:       for (const p of this.walkAbs(root)) {\n41:         yield { tplPath: p, target: join(baseDir, LAYOUT[dir], relative(root, p)), baseName: basename(p) };\n42:       }\n43:     }\n44:     const pluginsRoot = this.opts.harnessTemplatesRoot ? join(this.opts.harnessTemplatesRoot, 'plugins') : null;\n45:     if (pluginsRoot && existsSync(pluginsRoot)) {\n46:       for (const p of this.walkAbs(pluginsRoot)) {\n47:         yield {\n48:           tplPath: p,\n49:           target: join(baseDir, '.opencode/plugins', relative(pluginsRoot, p)),\n50:           baseName: basename(p),\n51:         };\n52:       }\n53:     }\n54:   }\n55: \n56:   private *walkAbs(dir: string): Generator<string> {\n57:     if (!existsSync(dir)) return;\n58:     for (const e of readdirSync(dir)) {\n59:       const p = join(dir, e);\n60:       if (statSync(p).isDirectory()) yield* this.walkAbs(p);\n61:       else yield p;\n62:     }\n63:   }\n64: \n65:   async renderBaseSet(baseDir: string, bake?: BakeResolver): Promise<RenderOutcome[]> {\n66:     const outcomes: RenderOutcome[] = [];\n67:     for (const f of this.templateFiles(baseDir)) {\n68:       if (existsSync(f.target)) {\n69:         outcomes.push({ file: f.baseName, action: 'skipped', reason: 'exists (wx-политика)' });\n70:         continue;\n71:       }\n72:       await this.writeRendered(f, bake);\n73:       outcomes.push({ file: f.baseName, action: 'created' });\n74:     }\n75:     return outcomes;\n76:   }\n77: \n78:   async syncBaseSet(baseDir: string): Promise<{ outcomes: RenderOutcome[]; orphaned: string[] }> {\n79:     const outcomes: RenderOutcome[] = [];\n80:     const seen = new Set<string>();\n81:     for (const f of this.templateFiles(baseDir)) {\n82:       seen.add(f.target);\n83:       if (!existsSync(f.target)) {\n84:         await this.writeRendered(f);\n85:         outcomes.push({ file: f.baseName, action: 'created' });\n86:         continue;\n87:       }\n88:       const current = readFileSync(f.target, 'utf-8');\n89:       if (parseStamp(current) === null) {\n90:         outcomes.push({\n91:           file: f.baseName,\n92:           action: 'conflict',\n93:           reason: 'unstamped на месте шаблонного — владелец решает: переименовать / удалить / принять текущий',\n94:         });\n95:         continue;\n96:       }\n97:       const fresh = this.renderContent(f);\n98:       if (fresh === current) {\n99:         outcomes.push({ file: f.baseName, action: 'skipped', reason: 'content identical (M2)' });\n100:         continue;\n101:       }\n102:       await mkdir(join(f.target, '..'), { recursive: true });\n103:       await writeFile(f.target, fresh, 'utf-8');\n104:       outcomes.push({ file: f.baseName, action: 'updated' });\n105:     }\n106:     const orphaned: string[] = [];\n107:     const scanRoots = [\n108:       join(baseDir, '.opencode/agents'),\n109:       join(baseDir, '.opencode/skills'),\n110:       join(baseDir, '.opencode/command'),\n111:       join(baseDir, '.opencode/plugins'),\n112:     ];\n113:     for (const root of scanRoots) {\n114:       if (!existsSync(root)) continue;\n115:       for (const f of this.walkAbs(root)) {\n116:         if (!seen.has(f) && parseStamp(readFileSync(f, 'utf-8')) !== null) orphaned.push(relative(baseDir, f));\n117:       }\n118:     }\n119:     return { outcomes, orphaned };\n120:   }\n121: \n122:   private renderContent(f: TemplateFile, bake?: BakeResolver): string {\n123:     let rendered = substitute(readFileSync(f.tplPath, 'utf-8'), OPENCODE_MANIFEST);\n124:     const body = bake?.(f.baseName);\n125:     if (body) {\n126:       rendered += `\\n<!-- wolf:face baked (bake-in, §4) -->\\n${body}\\n`;\n127:     }\n128:     return insertStamp(rendered, { base: f.baseName, set: this.setVersion }, f.baseName);\n129:   }\n130: \n131:   private async writeRendered(f: TemplateFile, bake?: BakeResolver): Promise<void> {\n132:     await mkdir(join(f.target, '..'), { recursive: true });\n133:     await writeFile(f.target, this.renderContent(f, bake), 'utf-8');\n134:   }\n135: }\n\n(End of file - total 135 lines)\n</content>","metadata":{"preview":"// src/adapters/render/opencode/opencode-renderer.ts\nimport { existsSync, readFileSync, readdirSync, statSync } from 'fs';\nimport { basename, join, relative } from 'path';\nimport { mkdir, writeFile } from 'fs/promises';\nimport { BaseSetRenderer, BakeResolver, RenderOutcome } from '../../../ports/base-set-renderer.port.js';\nimport { OPENCODE_MANIFEST, substitute } from '../manifest.js';\nimport { insertStamp, parseStamp } from '../stamp.js';\nimport { wolfVersion } from '../templates-root.js';\n\nconst NEUTRAL_DIRS = ['agents', 'skills', 'commands'] as const;\nconst LAYOUT: Record<(typeof NEUTRAL_DIRS)[number], string> = {\n  agents: '.opencode/agents',\n  skills: '.opencode/skills',\n  commands: '.opencode/command',\n};\n\ninterface TemplateFile {\n  tplPath: string;\n  /** Цель посчитана в templateFiles: корень зависит от происхождения шаблона (NC1). */\n  target: string;","truncated":false,"loaded":[],"display":{"type":"file","path":"/tmp/wolfeval-v1/aa/A1/src/adapters/render/opencode/opencode-renderer.ts","text":"// src/adapters/render/opencode/opencode-renderer.ts\nimport { existsSync, readFileSync, readdirSync, statSync } from 'fs';\nimport { basename, join, relative } from 'path';\nimport { mkdir, writeFile } from 'fs/promises';\nimport { BaseSetRenderer, BakeResolver, RenderOutcome } from '../../../ports/base-set-renderer.port.js';\nimport { OPENCODE_MANIFEST, substitute } from '../manifest.js';\nimport { insertStamp, parseStamp } from '../stamp.js';\nimport { wolfVersion } from '../templates-root.js';\n\nconst NEUTRAL_DIRS = ['agents', 'skills', 'commands'] as const;\nconst LAYOUT: Record<(typeof NEUTRAL_DIRS)[number], string> = {\n  agents: '.opencode/agents',\n  skills: '.opencode/skills',\n  commands: '.opencode/command',\n};\n\ninterface TemplateFile {\n  tplPath: string;\n  /** Цель посчитана в templateFiles: корень зависит от происхождения шаблона (NC1). */\n  target: string;\n  baseName: string;\n}\n\nexport class OpencodeBaseSetRenderer implements BaseSetRenderer {\n  id = 'opencode';\n\n  constructor(\n    private readonly baseTemplatesRoot: string,\n    private readonly opts: { harnessTemplatesRoot?: string; setVersion?: string } = {}\n  ) {}\n\n  private get setVersion(): string {\n    return this.opts.setVersion ?? wolfVersion();\n  }\n\n  /** NC1: harness-шаблоны резолвятся от СВОЕГО корня, не от baseTemplatesRoot. */\n  private *templateFiles(baseDir: string): Generator<TemplateFile> {\n    for (const dir of NEUTRAL_DIRS) {\n      const root = join(this.baseTemplatesRoot, dir);\n      for (const p of this.walkAbs(root)) {\n        yield { tplPath: p, target: join(baseDir, LAYOUT[dir], relative(root, p)), baseName: basename(p) };\n      }\n    }\n    const pluginsRoot = this.opts.harnessTemplatesRoot ? join(this.opts.harnessTemplatesRoot, 'plugins') : null;\n    if (pluginsRoot && existsSync(pluginsRoot)) {\n      for (const p of this.walkAbs(pluginsRoot)) {\n        yield {\n          tplPath: p,\n          target: join(baseDir, '.opencode/plugins', relative(pluginsRoot, p)),\n          baseName: basename(p),\n        };\n      }\n    }\n  }\n\n  private *walkAbs(dir: string): Generator<string> {\n    if (!existsSync(dir)) return;\n    for (const e of readdirSync(dir)) {\n      const p = join(dir, e);\n      if (statSync(p).isDirectory()) yield* this.walkAbs(p);\n      else yield p;\n    }\n  }\n\n  async renderBaseSet(baseDir: string, bake?: BakeResolver): Promise<RenderOutcome[]> {\n    const outcomes: RenderOutcome[] = [];\n    for (const f of this.templateFiles(baseDir)) {\n      if (existsSync(f.target)) {\n        outcomes.push({ file: f.baseName, action: 'skipped', reason: 'exists (wx-политика)' });\n        continue;\n      }\n      await this.writeRendered(f, bake);\n      outcomes.push({ file: f.baseName, action: 'created' });\n    }\n    return outcomes;\n  }\n\n  async syncBaseSet(baseDir: string): Promise<{ outcomes: RenderOutcome[]; orphaned: string[] }> {\n    const outcomes: RenderOutcome[] = [];\n    const seen = new Set<string>();\n    for (const f of this.templateFiles(baseDir)) {\n      seen.add(f.target);\n      if (!existsSync(f.target)) {\n        await this.writeRendered(f);\n        outcomes.push({ file: f.baseName, action: 'created' });\n        continue;\n      }\n      const current = readFileSync(f.target, 'utf-8');\n      if (parseStamp(current) === null) {\n        outcomes.push({\n          file: f.baseName,\n          action: 'conflict',\n          reason: 'unstamped на месте шаблонного — владелец решает: переименовать / удалить / принять текущий',\n        });\n        continue;\n      }\n      const fresh = this.renderContent(f);\n      if (fresh === current) {\n        outcomes.push({ file: f.baseName, action: 'skipped', reason: 'content identical (M2)' });\n        continue;\n      }\n      await mkdir(join(f.target, '..'), { recursive: true });\n      await writeFile(f.target, fresh, 'utf-8');\n      outcomes.push({ file: f.baseName, action: 'updated' });\n    }\n    const orphaned: string[] = [];\n    const scanRoots = [\n      join(baseDir, '.opencode/agents'),\n      join(baseDir, '.opencode/skills'),\n      join(baseDir, '.opencode/command'),\n      join(baseDir, '.opencode/plugins'),\n    ];\n    for (const root of scanRoots) {\n      if (!existsSync(root)) continue;\n      for (const f of this.walkAbs(root)) {\n        if (!seen.has(f) && parseStamp(readFileSync(f, 'utf-8')) !== null) orphaned.push(relative(baseDir, f));\n      }\n    }\n    return { outcomes, orphaned };\n  }\n\n  private renderContent(f: TemplateFile, bake?: BakeResolver): string {\n    let rendered = substitute(readFileSync(f.tplPath, 'utf-8'), OPENCODE_MANIFEST);\n    const body = bake?.(f.baseName);\n    if (body) {\n      rendered += `\\n<!-- wolf:face baked (bake-in, §4) -->\\n${body}\\n`;\n    }\n    return insertStamp(rendered, { base: f.baseName, set: this.setVersion }, f.baseName);\n  }\n\n  private async writeRendered(f: TemplateFile, bake?: BakeResolver): Promise<void> {\n    await mkdir(join(f.target, '..'), { recursive: true });\n    await writeFile(f.target, this.renderContent(f, bake), 'utf-8');\n  }\n}","lineStart":1,"lineEnd":135,"totalLines":135,"truncated":false}},"title":"../../../../../tmp/wolfeval-v1/aa/A1/src/adapters/render/opencode/opencode-renderer.ts","time":{"start":1788633800762,"end":1788633800791}},"id":"prt_072e1e035001pLuxNJzI55nGCD","sessionID":"ses_f8d1f048bffeWi62luRotMafVq","messageID":"msg_072e19aa3001h5qBi7QJCTp77N"}}
{"type":"tool_use","timestamp":1788633800801,"sessionID":"ses_f8d1f048bffeWi62luRotMafVq","part":{"type":"tool","tool":"read","callID":"call_9d4edd10c5824e92b1296ce8","state":{"status":"completed","input":{"filePath":"/tmp/wolfeval-v1/aa/A1/tests/e2e/init-cli.e2e.ts"},"output":"<path>/tmp/wolfeval-v1/aa/A1/tests/e2e/init-cli.e2e.ts</path>\n<type>file</type>\n<content>\n1: import { describe, it, expect } from 'vitest';\n2: import { spawnSync } from 'child_process';\n3: import { mkdtempSync, mkdirSync, writeFileSync, readFileSync, existsSync } from 'fs';\n4: import { tmpdir } from 'os';\n5: import { join, dirname } from 'path';\n6: import { fileURLToPath } from 'url';\n7: import { ensureBuilt } from './helpers.js';\n8: \n9: ensureBuilt();\n10: \n11: const REPO = join(dirname(fileURLToPath(import.meta.url)), '../..');\n12: const cli = join(REPO, 'dist', 'bootstrap', 'cli.js');\n13: \n14: const legacyMd =\n15:   '---\\nid: mem_legacy\\ntype: decision\\ntitle: Legacy decision\\nstatus: active\\nreview_state: accepted\\nconfidence: medium\\nimportance: 0.5\\ncreated_at: 2026-06-29T14:00:00Z\\nupdated_at: 2026-06-29T14:00:00Z\\ncreated_by: user:test\\nschema_version: 1\\nsource:\\n  kind: manual\\nrelated:\\n  files: []\\n  docs: []\\n  decisions: []\\ntags: []\\nsuperseded_by: null\\n---\\n\\nBody.\\n';\n16: \n17: /** Изолированное окружение: tmp XDG, чтобы e2e не трогал реальный ~/.config/wolf. */\n18: function env(xdg: string): NodeJS.ProcessEnv {\n19:   return { ...process.env, XDG_CONFIG_HOME: xdg };\n20: }\n21: \n22: function newProject(markers: 'opencode' | 'none'): { project: string; xdg: string } {\n23:   const project = mkdtempSync(join(tmpdir(), 'wolf-init-cli-'));\n24:   writeFileSync(join(project, 'package.json'), '{ \"name\": \"init-cli-e2e\" }');\n25:   if (markers === 'opencode') writeFileSync(join(project, 'opencode.json'), '{}');\n26:   const xdg = mkdtempSync(join(tmpdir(), 'wolf-init-cli-xdg-'));\n27:   return { project, xdg };\n28: }\n29: \n30: describe('wolf init CLI (спека §3 уровень 1)', () => {\n31:   it('writes canonical opencode config, registers project in XDG registry, re-init is a no-op', () => {\n32:     const { project, xdg } = newProject('opencode');\n33: \n34:     const first = spawnSync('node', [cli, 'init'], { cwd: project, env: env(xdg), encoding: 'utf-8', timeout: 60_000 });\n35:     expect(first.status).toBe(0);\n36:     expect(first.stdout).toContain('platform opencode: written');\n37:     expect(first.stdout).toContain('Restart your agent platform');\n38:     const cfg = JSON.parse(readFileSync(join(project, 'opencode.json'), 'utf-8'));\n39:     expect(cfg.mcp.wolf).toEqual({ type: 'local', command: ['wolf', 'mcp'], enabled: true });\n40:     expect(readFileSync(join(xdg, 'wolf', 'projects.yaml'), 'utf-8')).toContain(project);\n41: \n42:     const before = readFileSync(join(project, 'opencode.json'), 'utf-8');\n43:     const second = spawnSync('node', [cli, 'init'], {\n44:       cwd: project,\n45:       env: env(xdg),\n46:       encoding: 'utf-8',\n47:       timeout: 60_000,\n48:     });\n49:     expect(second.status).toBe(0);\n50:     expect(second.stdout).toContain('platform opencode: unchanged');\n51:     expect(readFileSync(join(project, 'opencode.json'), 'utf-8')).toBe(before);\n52:   });\n53: \n54:   it('unknown --platform → UserFacingError, exit 1, no configs written', () => {\n55:     const { project, xdg } = newProject('opencode');\n56:     const res = spawnSync('node', [cli, 'init', '--platform', 'vscode'], {\n57:       cwd: project,\n58:       env: env(xdg),\n59:       encoding: 'utf-8',\n60:       timeout: 60_000,\n61:     });\n62:     expect(res.status).toBe(1);\n63:     expect(res.stderr).toContain('Unknown platform');\n64:     expect(JSON.parse(readFileSync(join(project, 'opencode.json'), 'utf-8')).mcp).toBeUndefined();\n65:   });\n66: \n67:   it('no platform markers → skip with hint, exit 0 (память создана)', () => {\n68:     const { project, xdg } = newProject('none');\n69:     const res = spawnSync('node', [cli, 'init'], { cwd: project, env: env(xdg), encoding: 'utf-8', timeout: 60_000 });\n70:     expect(res.status).toBe(0);\n71:     expect(res.stdout).toContain('platform configs: skipped');\n72:     expect(res.stdout).toContain('--platform');\n73:   });\n74: \n75:   it('init --recreate on a LEGACY project migrates properly (marker + layout v2, objects/ not orphaned)', () => {\n76:     const { project, xdg } = newProject('opencode');\n77:     // легаси-состояние догфудера: config без маркера + layout v1 (objects/)\n78:     mkdirSync(join(project, '.wolf', 'memory', 'objects', 'decision'), { recursive: true });\n79:     writeFileSync(join(project, '.wolf', 'config.yaml'), 'artifact_sources: []\\n');\n80:     writeFileSync(join(project, '.wolf', 'memory', 'objects', 'decision', 'mem_legacy.md'), legacyMd);\n81: \n82:     const res = spawnSync('node', [cli, 'init', '--recreate'], {\n83:       cwd: project,\n84:       env: env(xdg),\n85:       encoding: 'utf-8',\n86:       timeout: 60_000,\n87:     });\n88:     expect(res.status).toBe(0);\n89:     // маркер проставлен ЧЕРЕЗ миграцию, а не тихой допиской: layout v2 применён\n90:     expect(readFileSync(join(project, '.wolf', 'config.yaml'), 'utf-8')).toContain('schema_version: 2');\n91:     expect(existsSync(join(project, '.wolf', 'memory', 'objects', 'decision', 'mem_legacy.md'))).toBe(false);\n92:     expect(existsSync(join(project, '.wolf', 'memory', 'shared', 'decisions', 'mem_legacy.md'))).toBe(true);\n93:   });\n94: \n95:   it('init --recreate on schema-from-future → honest refusal, no downgrade, config untouched', () => {\n96:     const { project, xdg } = newProject('opencode');\n97:     const body = 'artifact_sources: []\\nschema_version: 99\\n';\n98:     mkdirSync(join(project, '.wolf'), { recursive: true });\n99:     writeFileSync(join(project, '.wolf', 'config.yaml'), body);\n100: \n101:     const res = spawnSync('node', [cli, 'init', '--recreate'], {\n102:       cwd: project,\n103:       env: env(xdg),\n104:       encoding: 'utf-8',\n105:       timeout: 60_000,\n106:     });\n107:     expect(res.status).toBe(1);\n108:     expect(res.stderr).toContain('npm install -g mister-wolf');\n109:     // 99 не перезаписана на 2 (тихий даунгрейд запрещён), конфиг байт-в-байт\n110:     expect(readFileSync(join(project, '.wolf', 'config.yaml'), 'utf-8')).toBe(body);\n111:   });\n112: });\n\n(End of file - total 112 lines)\n</content>","metadata":{"preview":"import { describe, it, expect } from 'vitest';\nimport { spawnSync } from 'child_process';\nimport { mkdtempSync, mkdirSync, writeFileSync, readFileSync, existsSync } from 'fs';\nimport { tmpdir } from 'os';\nimport { join, dirname } from 'path';\nimport { fileURLToPath } from 'url';\nimport { ensureBuilt } from './helpers.js';\n\nensureBuilt();\n\nconst REPO = join(dirname(fileURLToPath(import.meta.url)), '../..');\nconst cli = join(REPO, 'dist', 'bootstrap', 'cli.js');\n\nconst legacyMd =\n  '---\\nid: mem_legacy\\ntype: decision\\ntitle: Legacy decision\\nstatus: active\\nreview_state: accepted\\nconfidence: medium\\nimportance: 0.5\\ncreated_at: 2026-06-29T14:00:00Z\\nupdated_at: 2026-06-29T14:00:00Z\\ncreated_by: user:test\\nschema_version: 1\\nsource:\\n  kind: manual\\nrelated:\\n  files: []\\n  docs: []\\n  decisions: []\\ntags: []\\nsuperseded_by: null\\n---\\n\\nBody.\\n';\n\n/** Изолированное окружение: tmp XDG, чтобы e2e не трогал реальный ~/.config/wolf. */\nfunction env(xdg: string): NodeJS.ProcessEnv {\n  return { ...process.env, XDG_CONFIG_HOME: xdg };\n}","truncated":false,"loaded":[],"display":{"type":"file","path":"/tmp/wolfeval-v1/aa/A1/tests/e2e/init-cli.e2e.ts","text":"import { describe, it, expect } from 'vitest';\nimport { spawnSync } from 'child_process';\nimport { mkdtempSync, mkdirSync, writeFileSync, readFileSync, existsSync } from 'fs';\nimport { tmpdir } from 'os';\nimport { join, dirname } from 'path';\nimport { fileURLToPath } from 'url';\nimport { ensureBuilt } from './helpers.js';\n\nensureBuilt();\n\nconst REPO = join(dirname(fileURLToPath(import.meta.url)), '../..');\nconst cli = join(REPO, 'dist', 'bootstrap', 'cli.js');\n\nconst legacyMd =\n  '---\\nid: mem_legacy\\ntype: decision\\ntitle: Legacy decision\\nstatus: active\\nreview_state: accepted\\nconfidence: medium\\nimportance: 0.5\\ncreated_at: 2026-06-29T14:00:00Z\\nupdated_at: 2026-06-29T14:00:00Z\\ncreated_by: user:test\\nschema_version: 1\\nsource:\\n  kind: manual\\nrelated:\\n  files: []\\n  docs: []\\n  decisions: []\\ntags: []\\nsuperseded_by: null\\n---\\n\\nBody.\\n';\n\n/** Изолированное окружение: tmp XDG, чтобы e2e не трогал реальный ~/.config/wolf. */\nfunction env(xdg: string): NodeJS.ProcessEnv {\n  return { ...process.env, XDG_CONFIG_HOME: xdg };\n}\n\nfunction newProject(markers: 'opencode' | 'none'): { project: string; xdg: string } {\n  const project = mkdtempSync(join(tmpdir(), 'wolf-init-cli-'));\n  writeFileSync(join(project, 'package.json'), '{ \"name\": \"init-cli-e2e\" }');\n  if (markers === 'opencode') writeFileSync(join(project, 'opencode.json'), '{}');\n  const xdg = mkdtempSync(join(tmpdir(), 'wolf-init-cli-xdg-'));\n  return { project, xdg };\n}\n\ndescribe('wolf init CLI (спека §3 уровень 1)', () => {\n  it('writes canonical opencode config, registers project in XDG registry, re-init is a no-op', () => {\n    const { project, xdg } = newProject('opencode');\n\n    const first = spawnSync('node', [cli, 'init'], { cwd: project, env: env(xdg), encoding: 'utf-8', timeout: 60_000 });\n    expect(first.status).toBe(0);\n    expect(first.stdout).toContain('platform opencode: written');\n    expect(first.stdout).toContain('Restart your agent platform');\n    const cfg = JSON.parse(readFileSync(join(project, 'opencode.json'), 'utf-8'));\n    expect(cfg.mcp.wolf).toEqual({ type: 'local', command: ['wolf', 'mcp'], enabled: true });\n    expect(readFileSync(join(xdg, 'wolf', 'projects.yaml'), 'utf-8')).toContain(project);\n\n    const before = readFileSync(join(project, 'opencode.json'), 'utf-8');\n    const second = spawnSync('node', [cli, 'init'], {\n      cwd: project,\n      env: env(xdg),\n      encoding: 'utf-8',\n      timeout: 60_000,\n    });\n    expect(second.status).toBe(0);\n    expect(second.stdout).toContain('platform opencode: unchanged');\n    expect(readFileSync(join(project, 'opencode.json'), 'utf-8')).toBe(before);\n  });\n\n  it('unknown --platform → UserFacingError, exit 1, no configs written', () => {\n    const { project, xdg } = newProject('opencode');\n    const res = spawnSync('node', [cli, 'init', '--platform', 'vscode'], {\n      cwd: project,\n      env: env(xdg),\n      encoding: 'utf-8',\n      timeout: 60_000,\n    });\n    expect(res.status).toBe(1);\n    expect(res.stderr).toContain('Unknown platform');\n    expect(JSON.parse(readFileSync(join(project, 'opencode.json'), 'utf-8')).mcp).toBeUndefined();\n  });\n\n  it('no platform markers → skip with hint, exit 0 (память создана)', () => {\n    const { project, xdg } = newProject('none');\n    const res = spawnSync('node', [cli, 'init'], { cwd: project, env: env(xdg), encoding: 'utf-8', timeout: 60_000 });\n    expect(res.status).toBe(0);\n    expect(res.stdout).toContain('platform configs: skipped');\n    expect(res.stdout).toContain('--platform');\n  });\n\n  it('init --recreate on a LEGACY project migrates properly (marker + layout v2, objects/ not orphaned)', () => {\n    const { project, xdg } = newProject('opencode');\n    // легаси-состояние догфудера: config без маркера + layout v1 (objects/)\n    mkdirSync(join(project, '.wolf', 'memory', 'objects', 'decision'), { recursive: true });\n    writeFileSync(join(project, '.wolf', 'config.yaml'), 'artifact_sources: []\\n');\n    writeFileSync(join(project, '.wolf', 'memory', 'objects', 'decision', 'mem_legacy.md'), legacyMd);\n\n    const res = spawnSync('node', [cli, 'init', '--recreate'], {\n      cwd: project,\n      env: env(xdg),\n      encoding: 'utf-8',\n      timeout: 60_000,\n    });\n    expect(res.status).toBe(0);\n    // маркер проставлен ЧЕРЕЗ миграцию, а не тихой допиской: layout v2 применён\n    expect(readFileSync(join(project, '.wolf', 'config.yaml'), 'utf-8')).toContain('schema_version: 2');\n    expect(existsSync(join(project, '.wolf', 'memory', 'objects', 'decision', 'mem_legacy.md'))).toBe(false);\n    expect(existsSync(join(project, '.wolf', 'memory', 'shared', 'decisions', 'mem_legacy.md'))).toBe(true);\n  });\n\n  it('init --recreate on schema-from-future → honest refusal, no downgrade, config untouched', () => {\n    const { project, xdg } = newProject('opencode');\n    const body = 'artifact_sources: []\\nschema_version: 99\\n';\n    mkdirSync(join(project, '.wolf'), { recursive: true });\n    writeFileSync(join(project, '.wolf', 'config.yaml'), body);\n\n    const res = spawnSync('node', [cli, 'init', '--recreate'], {\n      cwd: project,\n      env: env(xdg),\n      encoding: 'utf-8',\n      timeout: 60_000,\n    });\n    expect(res.status).toBe(1);\n    expect(res.stderr).toContain('npm install -g mister-wolf');\n    // 99 не перезаписана на 2 (тихий даунгрейд запрещён), конфиг байт-в-байт\n    expect(readFileSync(join(project, '.wolf', 'config.yaml'), 'utf-8')).toBe(body);\n  });\n});","lineStart":1,"lineEnd":112,"totalLines":112,"truncated":false}},"title":"../../../../../tmp/wolfeval-v1/aa/A1/tests/e2e/init-cli.e2e.ts","time":{"start":1788633800770,"end":1788633800797}},"id":"prt_072e1e03c001iv8Sh06SePyAeT","sessionID":"ses_f8d1f048bffeWi62luRotMafVq","messageID":"msg_072e19aa3001h5qBi7QJCTp77N"}}
