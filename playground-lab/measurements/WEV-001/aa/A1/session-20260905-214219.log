esult = await initProject({ ...deps, baseSet: renderFactBaseSet }, dir, { platformIds: ['claude'] });\n+  expect(result.platformOutcomes).toEqual([\n+    { platform: 'opencode', action: 'removed', reason: 'wolf entry removed (--platform list)' },\n+    { platform: 'claude', action: 'written' },\n+  ]);\n+  expect(oc.writeCalls).toBe(0);\n+  expect(claude.writeCalls).toBe(1);\n+});\n+\n it('explicit --platform list REPLACES the set: non-listed detected platform loses its wolf entry', async () => {\n   writeFileSync(join(dir, 'package.json'), '{}');\n   const oc = new FakeAdapter('opencode', true);\n   const claude = new FakeAdapter('claude', true);\n","filediff":{"file":"/tmp/wolfeval-v1/aa/A1/tests/unit/use-cases/init-project.test.ts","patch":"Index: /tmp/wolfeval-v1/aa/A1/tests/unit/use-cases/init-project.test.ts\n===================================================================\n--- /tmp/wolfeval-v1/aa/A1/tests/unit/use-cases/init-project.test.ts\n+++ /tmp/wolfeval-v1/aa/A1/tests/unit/use-cases/init-project.test.ts\n@@ -148,8 +148,49 @@\n   ]);\n   expect(deps.registry.registered).toHaveLength(1);\n });\n \n+// F4 (спека onboarding-v2 §4.4/D2): авто-детект «не видит» .opencode/, который init\n+// создаёт сам, — свежий проект opencode-пользователя без маркеров оставался без\n+// конфига до второго запуска. Платформа базового набора покрывается фактом рендера.\n+const renderFactBaseSet = { platform: 'opencode', render: async () => [], seed: async () => [] };\n+\n+it('F4: платформа базового набора пишется фактом рендера — без маркеров, с первого прогона', async () => {\n+  writeFileSync(join(dir, 'package.json'), '{}');\n+  const oc = new FakeAdapter('opencode', false); // детекция молчит — конфиг всё равно нужен\n+  const claude = new FakeAdapter('claude', false);\n+  const deps = makeDeps([oc, claude]);\n+  const result = await initProject({ ...deps, baseSet: renderFactBaseSet }, dir);\n+  expect(result.platformOutcomes).toEqual([\n+    { platform: 'opencode', action: 'written', reason: 'base set render target — covered by render, not detection (F4)' },\n+  ]);\n+  expect(oc.writeCalls).toBe(1);\n+  expect(claude.writeCalls).toBe(0);\n+});\n+\n+it('F4: факт рендера объединяется с маркерной детекцией без дублей (маркер есть — reason не добавляется)', async () => {\n+  writeFileSync(join(dir, 'package.json'), '{}');\n+  const oc = new FakeAdapter('opencode', true);\n+  const deps = makeDeps([oc]);\n+  const result = await initProject({ ...deps, baseSet: renderFactBaseSet }, dir);\n+  expect(result.platformOutcomes).toEqual([{ platform: 'opencode', action: 'written' }]);\n+  expect(oc.writeCalls).toBe(1);\n+});\n+\n+it('F4: явный --platform claude при implied opencode — контракт замены сохранён (wolf-запись opencode удаляется)', async () => {\n+  writeFileSync(join(dir, 'package.json'), '{}');\n+  const oc = new FakeAdapter('opencode', false);\n+  const claude = new FakeAdapter('claude', false);\n+  const deps = makeDeps([oc, claude]);\n+  const result = await initProject({ ...deps, baseSet: renderFactBaseSet }, dir, { platformIds: ['claude'] });\n+  expect(result.platformOutcomes).toEqual([\n+    { platform: 'opencode', action: 'removed', reason: 'wolf entry removed (--platform list)' },\n+    { platform: 'claude', action: 'written' },\n+  ]);\n+  expect(oc.writeCalls).toBe(0);\n+  expect(claude.writeCalls).toBe(1);\n+});\n+\n it('explicit --platform list REPLACES the set: non-listed detected platform loses its wolf entry', async () => {\n   writeFileSync(join(dir, 'package.json'), '{}');\n   const oc = new FakeAdapter('opencode', true);\n   const claude = new FakeAdapter('claude', true);\n","additions":41,"deletions":0},"truncated":false},"title":"../../../../../tmp/wolfeval-v1/aa/A1/tests/unit/use-cases/init-project.test.ts","time":{"start":1788634045549,"end":1788634045568}},"id":"prt_072e59c66001uKXERKcc1Ifjkb","sessionID":"ses_f8d1f048bffeWi62luRotMafVq","messageID":"msg_072e563200016KWZYwOu7txerI"}}
