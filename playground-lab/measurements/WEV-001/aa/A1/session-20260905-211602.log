{"type":"tool_use","timestamp":1788632386216,"sessionID":"ses_f8d36e605ffe5RBblB4DuaFHzr","part":{"type":"tool","tool":"read","callID":"call_20726e812b5c46be8910e971","state":{"status":"completed","input":{"filePath":"/private/tmp/wolfeval-v1/aa/A1/tests/e2e/base-set.e2e.ts","limit":60},"output":"<path>/private/tmp/wolfeval-v1/aa/A1/tests/e2e/base-set.e2e.ts</path>\n<type>file</type>\n<content>\n1: // tests/e2e/base-set.e2e.ts\n2: // E2E базового набора (спека §11.1, §11.6): init через dist CLI в tmp-проекте\n3: // (tmp-HOME изоляция) → структура; sync-сценарии: updated / conflict / orphaned.\n4: import { describe, it, expect, beforeAll, afterAll } from 'vitest';\n5: import { spawnSync } from 'child_process';\n6: import { mkdtempSync, writeFileSync, readFileSync, readdirSync, existsSync, rmSync } from 'fs';\n7: import { tmpdir } from 'os';\n8: import { join, dirname } from 'path';\n9: import { fileURLToPath } from 'url';\n10: import { ensureBuilt } from './helpers.js';\n11: \n12: ensureBuilt();\n13: \n14: const REPO = join(dirname(fileURLToPath(import.meta.url)), '../..');\n15: const cli = join(REPO, 'dist', 'bootstrap', 'cli.js');\n16: \n17: /** Изоляция: tmp XDG (реестр проектов) + срез npm_command (npx-запуск теста не должен выглядеть как npx try-out CLI). */\n18: function env(xdg: string): NodeJS.ProcessEnv {\n19:   const { npm_command: _drop, ...rest } = process.env;\n20:   return { ...rest, XDG_CONFIG_HOME: xdg };\n21: }\n22: \n23: function run(args: string[], cwd: string, xdg: string) {\n24:   const r = spawnSync('node', [cli, ...args], { cwd, env: env(xdg), encoding: 'utf-8', timeout: 60_000 });\n25:   return { stdout: r.stdout ?? '', stderr: r.stderr ?? '', status: r.status };\n26: }\n27: \n28: describe('wolf base set: init + sync (спека §7, §11.1, §11.6)', () => {\n29:   let project: string;\n30:   let xdg: string;\n31: \n32:   beforeAll(() => {\n33:     project = mkdtempSync(join(tmpdir(), 'wolf-base-set-e2e-'));\n34:     writeFileSync(join(project, 'package.json'), '{ \"name\": \"base-set-e2e\" }');\n35:     xdg = mkdtempSync(join(tmpdir(), 'wolf-base-set-e2e-xdg-'));\n36:     const res = run(['init'], project, xdg);\n37:     expect(res.status).toBe(0);\n38:     expect(res.stdout).toMatch(/- base set: \\S+ created/);\n39:   });\n40:   afterAll(() => {\n41:     rmSync(project, { recursive: true, force: true });\n42:     rmSync(xdg, { recursive: true, force: true });\n43:   });\n44: \n45:   it('init: структура .opencode/ (agents/skills/command/plugins) + .wolf/ (§11.1)', () => {\n46:     const oc = (sub: string) => readdirSync(join(project, '.opencode', sub));\n47:     expect(oc('agents').filter((f) => f.endsWith('.md'))).toHaveLength(6);\n48:     expect(oc('command').filter((f) => f.endsWith('.md'))).toHaveLength(3);\n49:     expect(oc('plugins').filter((f) => /\\.(js|ts)$/.test(f))).toHaveLength(2);\n50:     expect(existsSync(join(project, '.opencode/skills/using-skills/SKILL.md'))).toBe(true);\n51:     expect(existsSync(join(project, '.wolf'))).toBe(true);\n52:     // плагины прошли через рендер: штамп на месте\n53:     const plugin = readFileSync(join(project, '.opencode/plugins/wolf-session-start.js'), 'utf-8');\n54:     expect(plugin).toContain('// wolf:rendered base=wolf-session-start.js');\n55:   });\n56: \n57:   it('sync: правка штампованного файла (штамп сохранён) → updated, контент перезаписан из шаблона (§11.6)', () => {\n58:     const p = join(project, '.opencode/command/analyze-doc.md');\n59:     const stamped = readFileSync(p, 'utf-8');\n60:     writeFileSync(p, `${stamped}\\nE2E-EDIT-LINE\\n`); // правка внутри, штамп не тронут\n\n(Showing lines 1-60 of 87. Use offset=61 to continue.)\n</content>","metadata":{"preview":"// tests/e2e/base-set.e2e.ts\n// E2E базового набора (спека §11.1, §11.6): init через dist CLI в tmp-проекте\n// (tmp-HOME изоляция) → структура; sync-сценарии: updated / conflict / orphaned.\nimport { describe, it, expect, beforeAll, afterAll } from 'vitest';\nimport { spawnSync } from 'child_process';\nimport { mkdtempSync, writeFileSync, readFileSync, readdirSync, existsSync, rmSync } from 'fs';\nimport { tmpdir } from 'os';\nimport { join, dirname } from 'path';\nimport { fileURLToPath } from 'url';\nimport { ensureBuilt } from './helpers.js';\n\nensureBuilt();\n\nconst REPO = join(dirname(fileURLToPath(import.meta.url)), '../..');\nconst cli = join(REPO, 'dist', 'bootstrap', 'cli.js');\n\n/** Изоляция: tmp XDG (реестр проектов) + срез npm_command (npx-запуск теста не должен выглядеть как npx try-out CLI). */\nfunction env(xdg: string): NodeJS.ProcessEnv {\n  const { npm_command: _drop, ...rest } = process.env;\n  return { ...rest, XDG_CONFIG_HOME: xdg };","truncated":true,"loaded":[],"display":{"type":"file","path":"/private/tmp/wolfeval-v1/aa/A1/tests/e2e/base-set.e2e.ts","text":"// tests/e2e/base-set.e2e.ts\n// E2E базового набора (спека §11.1, §11.6): init через dist CLI в tmp-проекте\n// (tmp-HOME изоляция) → структура; sync-сценарии: updated / conflict / orphaned.\nimport { describe, it, expect, beforeAll, afterAll } from 'vitest';\nimport { spawnSync } from 'child_process';\nimport { mkdtempSync, writeFileSync, readFileSync, readdirSync, existsSync, rmSync } from 'fs';\nimport { tmpdir } from 'os';\nimport { join, dirname } from 'path';\nimport { fileURLToPath } from 'url';\nimport { ensureBuilt } from './helpers.js';\n\nensureBuilt();\n\nconst REPO = join(dirname(fileURLToPath(import.meta.url)), '../..');\nconst cli = join(REPO, 'dist', 'bootstrap', 'cli.js');\n\n/** Изоляция: tmp XDG (реестр проектов) + срез npm_command (npx-запуск теста не должен выглядеть как npx try-out CLI). */\nfunction env(xdg: string): NodeJS.ProcessEnv {\n  const { npm_command: _drop, ...rest } = process.env;\n  return { ...rest, XDG_CONFIG_HOME: xdg };\n}\n\nfunction run(args: string[], cwd: string, xdg: string) {\n  const r = spawnSync('node', [cli, ...args], { cwd, env: env(xdg), encoding: 'utf-8', timeout: 60_000 });\n  return { stdout: r.stdout ?? '', stderr: r.stderr ?? '', status: r.status };\n}\n\ndescribe('wolf base set: init + sync (спека §7, §11.1, §11.6)', () => {\n  let project: string;\n  let xdg: string;\n\n  beforeAll(() => {\n    project = mkdtempSync(join(tmpdir(), 'wolf-base-set-e2e-'));\n    writeFileSync(join(project, 'package.json'), '{ \"name\": \"base-set-e2e\" }');\n    xdg = mkdtempSync(join(tmpdir(), 'wolf-base-set-e2e-xdg-'));\n    const res = run(['init'], project, xdg);\n    expect(res.status).toBe(0);\n    expect(res.stdout).toMatch(/- base set: \\S+ created/);\n  });\n  afterAll(() => {\n    rmSync(project, { recursive: true, force: true });\n    rmSync(xdg, { recursive: true, force: true });\n  });\n\n  it('init: структура .opencode/ (agents/skills/command/plugins) + .wolf/ (§11.1)', () => {\n    const oc = (sub: string) => readdirSync(join(project, '.opencode', sub));\n    expect(oc('agents').filter((f) => f.endsWith('.md'))).toHaveLength(6);\n    expect(oc('command').filter((f) => f.endsWith('.md'))).toHaveLength(3);\n    expect(oc('plugins').filter((f) => /\\.(js|ts)$/.test(f))).toHaveLength(2);\n    expect(existsSync(join(project, '.opencode/skills/using-skills/SKILL.md'))).toBe(true);\n    expect(existsSync(join(project, '.wolf'))).toBe(true);\n    // плагины прошли через рендер: штамп на месте\n    const plugin = readFileSync(join(project, '.opencode/plugins/wolf-session-start.js'), 'utf-8');\n    expect(plugin).toContain('// wolf:rendered base=wolf-session-start.js');\n  });\n\n  it('sync: правка штампованного файла (штамп сохранён) → updated, контент перезаписан из шаблона (§11.6)', () => {\n    const p = join(project, '.opencode/command/analyze-doc.md');\n    const stamped = readFileSync(p, 'utf-8');\n    writeFileSync(p, `${stamped}\\nE2E-EDIT-LINE\\n`); // правка внутри, штамп не тронут","lineStart":1,"lineEnd":60,"totalLines":87,"truncated":true}},"title":"tests/e2e/base-set.e2e.ts","time":{"start":1788632385845,"end":1788632385867}},"id":"prt_072cc4931001o4dxIvUpTQ8UE7","sessionID":"ses_f8d36e605ffe5RBblB4DuaFHzr","messageID":"msg_072cc2b1e001UAXtbePIhh2nKM"}}
