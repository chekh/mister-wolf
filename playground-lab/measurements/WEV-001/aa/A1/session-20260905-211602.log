5: });\n106: \n107: /* ---------- tests ---------- */\n108: \n109: describe('looksLikeProjectRoot (спека §6: init вне проекта → диагностика, ничего не создаётся)', () => {\n110:   it('empty dir is not a project root', () => {\n111:     expect(looksLikeProjectRoot(dir)).toBe(false);\n112:   });\n113: \n114:   it('package.json makes it a project root', () => {\n115:     writeFileSync(join(dir, 'package.json'), '{}');\n116:     expect(looksLikeProjectRoot(dir)).toBe(true);\n117:   });\n118: });\n119: \n120: describe('initProject', () => {\n121:   it('outside a project: throws UserFacingError, nothing created', async () => {\n122:     const deps = makeDeps([]);\n123:     await expect(initProject(deps, dir)).rejects.toThrow(/Not a project root/);\n124:     expect(deps.initializer.calls).toBe(0);\n125:     expect(deps.registry.registered).toHaveLength(0);\n126:   });\n127: \n128:   it('auto-detect: writes only detected platforms, marks schema, registers project', async () => {\n129:     writeFileSync(join(dir, 'package.json'), '{}');\n130:     const oc = new FakeAdapter('opencode', true);\n131:     const claude = new FakeAdapter('claude', false);\n132:     const deps = makeDeps([oc, claude]);\n133:     const result = await initProject(deps, dir);\n134:     expect(result.platformOutcomes).toEqual([{ platform: 'opencode', action: 'written' }]);\n135:     expect(oc.writeCalls).toBe(1);\n136:     expect(claude.writeCalls).toBe(0);\n137:     expect(markSpy.calls).toBe(1);\n138:     expect(deps.registry.registered).toEqual([{ path: dir, schemaVersion: CURRENT_SCHEMA_VERSION }]);\n139:     expect(result.documentCount).toBe(0);\n140:   });\n141: \n142:   it('no platform detected: warning+skip outcome, init still succeeds (память создана)', async () => {\n143:     writeFileSync(join(dir, 'package.json'), '{}');\n144:     const deps = makeDeps([new FakeAdapter('opencode', false), new FakeAdapter('claude', false)]);\n145:     const result = await initProject(deps, dir);\n146:     ex