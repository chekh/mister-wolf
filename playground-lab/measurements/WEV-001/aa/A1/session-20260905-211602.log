{"type":"tool_use","timestamp":1788632225624,"sessionID":"ses_f8d36e605ffe5RBblB4DuaFHzr","part":{"type":"tool","tool":"read","callID":"call_4114786ed01842f0ac8f51bd","state":{"status":"completed","input":{"filePath":"/private/tmp/wolfeval-v1/aa/A1/src/adapters/render/opencode/opencode-renderer.ts"},"output":"<path>/private/tmp/wolfeval-v1/aa/A1/src/adapters/render/opencode/opencode-renderer.ts</path>\n<type>file</type>\n<content>\n1: // src/adapters/render/opencode/opencode-renderer.ts\n2: import { existsSync, readFileSync, readdirSync, statSync } from 'fs';\n3: import { basename, join, relative } from 'path';\n4: import { mkdir, writeFile } from 'fs/promises';\n5: import { BaseSetRenderer, BakeResolver, RenderOutcome } from '../../../ports/base-set-renderer.port.js';\n6: import { OPENCODE_MANIFEST, substitute } from '../manifest.js';\n7: import { insertStamp, parseStamp } from '../stamp.js';\n8: import { wolfVersion } from '../templates-root.js';\n9: \n10: const NEUTRAL_DIRS = ['agents', 'skills', 'commands'] as const;\n11: const LAYOUT: Record<(typeof NEUTRAL_DIRS)[number], string> = {\n12:   agents: '.opencode/agents',\n13:   skills: '.opencode/skills',\n14:   commands: '.opencode/command',\n15: };\n16: \n17: interface TemplateFile {\n18:   tplPath: string;\n19:   /** Цель посчитана в templateFiles: корень зависит от происхождения шаблона (NC1). */\n20:   target: string;\n21:   baseName: string;\n22: }\n23: \n24: export class OpencodeBaseSetRenderer implements BaseSetRenderer {\n25:   id = 'opencode';\n26: \n27:   constructor(\n28:     private readonly baseTemplatesRoot: string,\n29:     private readonly opts: { harnessTemplatesRoot?: string; setVersion?: string } = {}\n30:   ) {}\n31: \n32:   private get setVersion(): string {\n33:     return this.opts.setVersion ?? wolfVersion();\n34:   }\n35: \n36:   /** NC1: harness-шаблоны резолвятся от СВОЕГО корня, не от baseTemplatesRoot. */\n37:   private *templateFiles(baseDir: string): Generator<TemplateFile> {\n38:     for (const dir of NEUTRAL_DIRS) {\n39:       const root = join(this.baseTemplatesRoot, dir);\n40:       for (const p of this.walkAbs(root)) {\n41:         yield { tplPath: p, target: join(baseDir, LAYOUT[dir], relative(root, p)), baseName: basename(p) };\n42:       }\n43:     }\n44:     const pluginsRoot = this.opts.harnessTemplatesRoot ? join(this.opts.harnessTemplatesRoot, 'plugins') : null;\n45:     if (pluginsRoot && existsSync(pluginsRoot)) {\n46:       for (const p of this.walkAbs(pluginsRoot)) {\n47:         yield {\n48:           tplPath: p,\n49:           target: join(baseDir, '.opencode/plugins', relative(pluginsRoot, p)),\n50:           baseName: basename(p),\n51:         };\n52:       }\n53:     }\n54:   }\n55: \n56:   private *walkAbs(dir: string): Generator<string> {\n57:     if (!existsSync(dir)) return;\n58:     for (const e of readdirSync(dir)) {\n59:       const p = join(dir, e);\n60:       if (statSync(p).isDirectory()) yield* this.walkAbs(p);\n61:       else yield p;\n62:     }\n63:   }\n64: \n65:   async renderBaseSet(baseDir: string, bake?: BakeResolver): Promise<RenderOutcome[]> {\n66:     const outcomes: RenderOutcome[] = [];\n67:     for (const f of this.templateFiles(baseDir)) {\n68:       if (existsSync(f.target)) {\n69:         outcomes.push({ file: f.baseName, action: 'skipped', reason: 'exists (wx-политика)' });\n70:         continue;\n71:       }\n72:       await this.writeRendered(f, bake);\n73:       outcomes.push({ file: f.baseName, action: 'created' });\n74:     }\n75:     return outcomes;\n76:   }\n77: \n78:   async syncBaseSet(baseDir: string): Promise<{ outcomes: RenderOutcome[]; orphaned: string[] }> {\n79:     const outcomes: RenderOutcome[] = [];\n80:     const seen = new Set<string>();\n81:     for (const f of this.templateFiles(baseDir)) {\n82:       seen.add(f.target);\n83:       if (!existsSync(f.target)) {\n84:         await this.writeRendered(f);\n85:         outcomes.push({ file: f.baseName, action: 'created' });\n86:         continue;\n87:       }\n88:       const current = readFileSync(f.target, 'utf-8');\n89:       if (parseStamp(current) === null) {\n90:         outcomes.push({\n91:           file: f.baseName,\n92:           action: 'conflict',\n93:           reason: 'unstamped на месте шаблонного — владелец решает: переименовать / удалить / принять текущий',\n94:         });\n95:         continue;\n96:       }\n97:       const fresh = this.renderContent(f);\n98:       if (fresh === current) {\n99:         outcomes.push({ file: f.baseName, action: 'skipped', reason: 'content identical (M2)' });\n100:         continue;\n101:       }\n102:       await mkdir(join(f.target, '..'), { recursive: true });\n103:       await writeFile(f.target, fresh, 'utf-8');\n104:       outcomes.push({ file: f.baseName, action: 'updated' });\n105:     }\n106:     const orphaned: string[] = [];\n107:     const scanRoots = [\n108:       join(baseDir, '.opencode/agents'),\n109:       join(baseDir, '.opencode/skills'),\n110:       join(baseDir, '.opencode/command'),\n111:       join(baseDir, '.opencode/plugins'),\n112:     ];\n113:     for (const root of scanRoots) {\n114:       if (!existsSync(root)) continue;\n115:       for (const f of this.walkAbs(root)) {\n116:         if (!seen.has(f) && parseStamp(readFileSync(f, 'utf-8')) !== null) orphaned.push(relative(baseDir, f));\n117:       }\n118:     }\n119:     return { outcomes, orphaned };\n120:   }\n121: \n122:   private renderContent(f: TemplateFile, bake?: BakeResolver): string {\n123:     let rendered = substitute(readFileSync(f.tplPath, 'utf-8'), OPENCODE_MANIFEST);\n124:     const body = bake?.(f.baseName);\n125:     if (body) {\n126:       rendered += `\\n<!-- wolf:face baked (bake-in, §4) -->\\n${body}\\n`;\n127:     }\n128:     return insertStamp(rendered, { base: f.baseName, set: this.setVersion }, f.baseName);\n129:   }\n130: \n131:   private async writeRendered(f: TemplateFile, bake?: BakeResolver): Promise<void> {\n132:     await mkdir(join(f.target, '..'), { recursive: true });\n133:     await writeFile(f.target, this.renderContent(f, bake), 'utf-8');\n134:   }\n135: }\n\n(End of file - total 135 lines)\n</content>","metadata":{"preview":"// src/adapters/render/opencode/opencode-renderer.ts\nimport { existsSync, readFileSync, readdirSync, statSync } from 'fs';\nimport { basename, join, relative } from 'path';\nimport { mkdir, writeFile } from 'fs/promises';\nimport { BaseSetRenderer, BakeResolver, RenderOutcome } from '../../../ports/base-set-renderer.port.js';\nimport { OPENCODE_MANIFEST, substitute } from '../manifest.js';\nimport { insertStamp, parseStamp } from '../stamp.js';\nimport { wolfVersion } from '../templates-root.js';\n\nconst NEUTRAL_DIRS = ['agents', 'skills', 'commands'] as const;\nconst LAYOUT: Record<(typeof NEUTRAL_DIRS)[number], string> = {\n  agents: '.opencode/agents',\n  skills: '.opencode/skills',\n  commands: '.opencode/command',\n};\n\ninterface TemplateFile {\n  tplPath: string;\n  /** Цель посчитана в templateFiles: корень зависит от происхождения шаблона (NC1). */\n  target: string;","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/wolfeval-v1/aa/A1/src/adapters/render/opencode/opencode-renderer.ts","text":"// src/adapters/render/opencode/opencode-renderer.ts\nimport { existsSync, readFileSync, readdirSync, statSync } from 'fs';\nimport { basename, join, relative } from 'path';\nimport { mkdir, writeFile } from 'fs/promises';\nimport { BaseSetRenderer, BakeResolver, RenderOutcome } from '../../../ports/base-set-renderer.port.js';\nimport { OPENCODE_MANIFEST, substitute } from '../manifest.js';\nimport { insertStamp, parseStamp } from '../stamp.js';\nimport { wolfVersion } from '../templates-root.js';\n\nconst NEUTRAL_DIRS = ['agents', 'skills', 'commands'] as const;\nconst LAYOUT: Record<(typeof NEUTRAL_DIRS)[number], string> = {\n  agents: '.opencode/agents',\n  skills: '.opencode/skills',\n  commands: '.opencode/command',\n};\n\ninterface TemplateFile {\n  tplPath: string;\n  /** Цель посчитана в templateFiles: корень зависит от происхождения шаблона (NC1). */\n  target: string;\n  baseName: string;\n}\n\nexport class OpencodeBaseSetRenderer implements BaseSetRenderer {\n  id = 'opencode';\n\n  constructor(\n    private readonly baseTemplatesRoot: string,\n    private readonly opts: { harnessTemplatesRoot?: string; setVersion?: string } = {}\n  ) {}\n\n  private get setVersion(): string {\n    return this.opts.setVersion ?? wolfVersion();\n  }\n\n  /** NC1: harness-шаблоны резолвятся от СВОЕГО корня, не от baseTemplatesRoot. */\n  private *templateFiles(baseDir: string): Generator<TemplateFile> {\n    for (const dir of NEUTRAL_DIRS) {\n      const root = join(this.baseTemplatesRoot, dir);\n      for (const p of this.walkAbs(root)) {\n        yield { tplPath: p, target: join(baseDir, LAYOUT[dir], relative(root, p)), baseName: basename(p) };\n      }\n    }\n    const pluginsRoot = this.opts.harnessTemplatesRoot ? join(this.opts.harnessTemplatesRoot, 'plugins') : null;\n    if (pluginsRoot && existsSync(pluginsRoot)) {\n      for (const p of this.walkAbs(pluginsRoot)) {\n        yield {\n          tplPath: p,\n          target: join(baseDir, '.opencode/plugins', relative(pluginsRoot, p)),\n          baseName: basename(p),\n        };\n      }\n    }\n  }\n\n  private *walkAbs(dir: string): Generator<string> {\n    if (!existsSync(dir)) return;\n    for (const e of readdirSync(dir)) {\n      const p = join(dir, e);\n      if (statSync(p).isDirectory()) yield* this.walkAbs(p);\n      else yield p;\n    }\n  }\n\n  async renderBaseSet(baseDir: string, bake?: BakeResolver): Promise<RenderOutcome[]> {\n    const outcomes: RenderOutcome[] = [];\n    for (const f of this.templateFiles(baseDir)) {\n      if (existsSync(f.target)) {\n        outcomes.push({ file: f.baseName, action: 'skipped', reason: 'exists (wx-политика)' });\n        continue;\n      }\n      await this.writeRendered(f, bake);\n      outcomes.push({ file: f.baseName, action: 'created' });\n    }\n    return outcomes;\n  }\n\n  async syncBaseSet(baseDir: string): Promise<{ outcomes: RenderOutcome[]; orphaned: string[] }> {\n    const outcomes: RenderOutcome[] = [];\n    const seen = new Set<string>();\n    for (const f of this.templateFiles(baseDir)) {\n      seen.add(f.target);\n      if (!existsSync(f.target)) {\n        await this.writeRendered(f);\n        outcomes.push({ file: f.baseName, action: 'created' });\n        continue;\n      }\n      const current = readFileSync(f.target, 'utf-8');\n      if (parseStamp(current) === null) {\n        outcomes.push({\n          file: f.baseName,\n          action: 'conflict',\n          reason: 'unstamped на месте шаблонного — владелец решает: переименовать / удалить / принять текущий',\n        });\n        continue;\n      }\n      const fresh = this.renderContent(f);\n      if (fresh === current) {\n        outcomes.push({ file: f.baseName, action: 'skipped', reason: 'content identical (M2)' });\n        continue;\n      }\n      await mkdir(join(f.target, '..'), { recursive: true });\n      await writeFile(f.target, fresh, 'utf-8');\n      outcomes.push({ file: f.baseName, action: 'updated' });\n    }\n    const orphaned: string[] = [];\n    const scanRoots = [\n      join(baseDir, '.opencode/agents'),\n      join(baseDir, '.opencode/skills'),\n      join(baseDir, '.opencode/command'),\n      join(baseDir, '.opencode/plugins'),\n    ];\n    for (const root of scanRoots) {\n      if (!existsSync(root)) continue;\n      for (const f of this.walkAbs(root)) {\n        if (!seen.has(f) && parseStamp(readFileSync(f, 'utf-8')) !== null) orphaned.push(relative(baseDir, f));\n      }\n    }\n    return { outcomes, orphaned };\n  }\n\n  private renderContent(f: TemplateFile, bake?: BakeResolver): string {\n    let rendered = substitute(readFileSync(f.tplPath, 'utf-8'), OPENCODE_MANIFEST);\n    const body = bake?.(f.baseName);\n    if (body) {\n      rendered += `\\n<!-- wolf:face baked (bake-in, §4) -->\\n${body}\\n`;\n    }\n    return insertStamp(rendered, { base: f.baseName, set: this.setVersion }, f.baseName);\n  }\n\n  private async writeRendered(f: TemplateFile, bake?: BakeResolver): Promise<void> {\n    await mkdir(join(f.target, '..'), { recursive: true });\n    await writeFile(f.target, this.renderContent(f, bake), 'utf-8');\n  }\n}","lineStart":1,"lineEnd":135,"totalLines":135,"truncated":false}},"title":"src/adapters/render/opencode/opencode-renderer.ts","time":{"start":1788632225504,"end":1788632225620}},"id":"prt_072c9d6da001dxNBuo6cfz88zU","sessionID":"ses_f8d36e605ffe5RBblB4DuaFHzr","messageID":"msg_072c9c28c001WMPOLcAaSgpE3L"}}
