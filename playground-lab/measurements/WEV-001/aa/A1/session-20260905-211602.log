nction makeDeps(adapters: FakeAdapter[], opts: { npx?: boolean } = {}) {\n+function makeDeps(adapters: FakeAdapter[], opts: { npx?: boolean; baseSet?: BaseSetDeps } = {}) {\n   return {\n     initializer: new FakeInitializer(),\n     registry: new FakeRegistry(),\n     adapters,\n@@ -90,11 +90,15 @@\n     } as unknown as Parameters<typeof scanProject>[0],\n     markSchemaCurrent: async () => {\n       markSpy.calls += 1;\n     },\n+    ...(opts.baseSet ? { baseSet: opts.baseSet } : {}),\n   };\n }\n \n+/** Пустой набор: рендер «происходит» (создаёт макет платформы), файлов не пишет. */\n+const emptyBaseSet: BaseSetDeps = { render: async () => [], seed: async () => [] };\n+\n /* ---------- env ---------- */\n \n let dir: string;\n \n","additions":5,"deletions":1},"truncated":false},"title":"tests/unit/use-cases/init-project.test.ts","time":{"start":1788632495912,"end":1788632495939}},"id":"prt_072cdf723001kuBoKz927SOe3y","sessionID":"ses_f8d36e605ffe5RBblB4DuaFHzr","messageID":"msg_072cdd00a0012draW3dOrNAE87"}}
