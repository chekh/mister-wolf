});\n    await expect(guard).resolves.toBeUndefined();\n  });\n});","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/wolf-l1v2-nomem/tests/unit/port-guard.test.ts","text":"import net from 'node:net';\nimport { describe, expect, it } from 'vitest';\n\n// Port-guard: тестовое окружение требует, чтобы порт 5173 был свободен.\ndescribe('port-guard', () => {\n  it('порт 5173 свободен', async () => {\n    const guard = new Promise<void>((resolve, reject) => {\n      const server = net.createServer();\n      server.once('error', (err: NodeJS.ErrnoException) => {\n        if (err.code === 'EADDRINUSE') {\n          reject(new Error('port-guard: порт 5173 занят (EADDRINUSE) — освободите его и перезапустите npm run check'));\n        } else {\n          reject(err);\n        }\n      });\n      server.listen(5173, '127.0.0.1', () => server.close(() => resolve()));\n    });\n    await expect(guard).resolves.toBeUndefined();\n  });\n});","lineStart":1,"lineEnd":20,"totalLines":20,"truncated":false}},"title":"private/tmp/wolf-l1v2-nomem/tests/unit/port-guard.test.ts","time":{"start":1788536735022,"end":1788536735091}},"id":"prt_06d18c51a001DtmD7b44ZJsrb2","sessionID":"ses_f92e90e08ffeUax1Kbq5cBosKT","messageID":"msg_06d18a9bf001LVQHkB67L86vpb"}}
