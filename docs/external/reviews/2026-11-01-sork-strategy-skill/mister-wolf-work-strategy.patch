diff --git a/tests/unit/adapters/render/work-strategy-delivery.test.ts b/tests/unit/adapters/render/work-strategy-delivery.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..106134be6fe2718c25077fe56df39d9fe6483780
