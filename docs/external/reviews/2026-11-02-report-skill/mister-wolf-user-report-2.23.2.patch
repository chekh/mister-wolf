+      baseDir: path,
+      toolOwners: new Set(),
+      baseSkillNames: new Set(readdirSync(join(base, 'skills'))),
+    });
+    expect(findings.filter((finding) => finding.file.includes('wolf-user-report'))).toEqual([]);
+  });
+});
